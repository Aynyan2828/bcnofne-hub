---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VoyagerCounter from '../components/VoyagerCounter.astro';
import VoyageRail from '../components/VoyageRail.astro';
import AynNavigator from '../components/AynNavigator.astro';
import LazyVideos from '../components/LazyVideos.astro';
import LatestVideo from '../components/LatestVideo.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Featured from '../components/Featured.astro';
import MoodPicker from '../components/MoodPicker.astro';
import HScroll from '../components/HScroll.astro';
import Reveal from '../components/Reveal.astro';
import Icon from '../components/Icon.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Feed from '../components/Feed.astro';
import Footer from '../components/Footer.astro';
import HairlineFigure from '../components/HairlineFigure.astro';
import ShipMark from '../components/ShipMark.astro';
import LangSwitch from '../components/LangSwitch.astro';

// 見出しの丸AYN・大きな水彩シーン
import aynOk from '../assets/ayn/ayn-ok.png';
import aynNight from '../assets/ayn/ayn-night.png';
import aynExcited from '../assets/ayn/ayn-excited.png';
import aynSmile from '../assets/ayn/ayn-smile.png';
import aynThinking from '../assets/ayn/ayn-thinking.png';
import { getWorklog, fmtLogDate, logAnchor } from '../lib/worklog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const visible = (e: { data: { status: string; order: number } }) =>
  e.data.status !== 'hidden' && e.data.status !== 'draft';
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const apps = (await getCollection('apps')).filter(visible).sort(byOrder);
const channels = (await getCollection('channels')).filter(visible).sort(byOrder);
const music = (await getCollection('music')).filter(visible).sort(byOrder);
// 音の港の棚を2つに分ける。単曲が増えると EP が埋もれるため（2026-10-05）。
// .md に kind: single と書いた分だけ下の棚に出る。書かんかったら今まで通り上の棚。
const musicEps = music.filter((m) => m.data.kind !== 'single');
const musicSingles = music.filter((m) => m.data.kind === 'single');
const social = (await getCollection('social')).filter(visible).sort(byOrder);

// Apps 港の主役（featured: true の1本）。残りは Other Apps。
// 主役を替えるのは .md の featured を付け替えるだけ（コードは触らんでよか）。
const featured = apps.find((a) => a.data.featured);
const otherApps = apps.filter((a) => a !== featured);

// SNS は強さで3段（pinned=ピル / primary=カード / more=その他の航路）
const pinned = social.filter((s) => s.data.tier === 'pinned');
const primarySocial = social.filter((s) => s.data.tier === 'primary');
const moreSocial = social.filter((s) => s.data.tier === 'more');

// 機関室の予告（AYN の機関日誌）。増えてきたら窓の中でスクロール（約 5 本ぶんの高さ）。
// ページが重くならんよう窓に入れるのは新しい 30 本まで。全部は /engine-room/
const LOG_WINDOW_MAX = 30;
const LOG_WINDOW_ROWS = 5;
const allLogs = await getWorklog();
const recentLogs = allLogs.slice(0, LOG_WINDOW_MAX);
const logScrolls = recentLogs.length > LOG_WINDOW_ROWS;
---
<BaseLayout alternates={[
  { lang: 'ja', path: '/' },
  { lang: 'en', path: '/en/' },
  { lang: 'x-default', path: '/' },
]}>
  <LangSwitch />
  <VoyageRail />
  <Hero />
  <VoyagerCounter />
  <main id="main">
    <Section
      id="apps"
      tone="blue"
      harbor="APPS HARBOR"
      harborLabel="アプリの港"
      harborAyn="ayn_apps"
      eyebrow="Apps"
      title="つくったアプリ"
      lead="ぼくが機関室から手伝いよる、iPhone アプリたち。ぜんぶ無料で始められるばい。"
      avatar={aynOk}
      avatarAlt="サムズアップするAYN"
    >
      {/* 桟橋に 3 つのアプリの木箱。指した箱が吊り上がる（Hairline・試作 2026-10-27） */}
      <div class="hlf-slot"><HairlineFigure name="pier" label="桟橋に 3 つのアプリの木箱。指した箱が吊り上がる：扶養メーター・ShiftWake・SubScope" /></div>
      {/* ショートカット集への入口（プロフィールの bcnofne.com から 2 タップで届くように・2026-10-21） */}
      <div class="scband" data-scband>
        <a class="scband__bar" href={`${base}/shortcuts/`}>
          <img class="scband__face" src={aynOk.src} alt="" width="30" height="30" />
          <span class="scband__text">無料の iPhone ショートカット集</span>
          <span class="scband__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      {featured && (
        <Featured
          title={featured.data.title}
          hook={featured.data.hook}
          summary={featured.data.summary}
          url={featured.data.url}
          cta={featured.data.cta}
          badge={featured.data.price}
          icon={featured.data.icon}
          demo={featured.data.demo ? `${base}${featured.data.demo}` : undefined}
          demoPoster={featured.data.demoPoster ? `${base}${featured.data.demoPoster}` : undefined}
          extraLinks={featured.data.extraLinks}
        />
      )}

      {otherApps.length > 0 && (
        <>
          <h3 class="subhead" data-reveal="up">
            <span class="subhead__en" data-type data-type-step="45">Other Apps</span>
            <span class="type" data-type data-type-delay="250">ほかのアプリ</span>
          </h3>
          <div class="grid" data-reveal-stagger>
            {otherApps.map((app) => (
              <Card
                title={app.data.title}
                summary={app.data.summary}
                url={app.data.url}
                cta={app.data.cta}
                badge={app.data.price}
                icon={app.data.icon}
              />
            ))}
          </div>

          {/* 縦型プロモは縦に積むと画面が果てしなく伸びるけん、横に流す棚へ */}
          <div class="shelf" data-reveal="up">
            <HScroll label="アプリの紹介動画" size="video" title="紹介動画" hint="AYN が使い方を案内しよる">
              <video
                data-lazyvideo
                data-src={`${base}/media/shiftwake_promo.mp4`}
                poster={`${base}/media/shiftwake_promo_poster.jpg`}
                width="720"
                height="1280"
                loop
                playsinline
                controls
                preload="none"
                class="shelfvideo"
                aria-label="ShiftWake の紹介動画。AYNがシフト自動アラームの使い方を案内する縦型プロモ。"
              ></video>
              <video
                data-lazyvideo
                data-src={`${base}/media/fuyo_promo.mp4`}
                poster={`${base}/media/fuyo_promo_poster.webp`}
                width="720"
                height="1280"
                loop
                playsinline
                controls
                preload="none"
                class="shelfvideo"
                aria-label="扶養メーターの紹介動画。AYNがアプリの使い方を案内する縦型プロモ。"
              ></video>
              <video
                data-lazyvideo
                data-src={`${base}/media/subscope_promo.mp4`}
                poster={`${base}/media/subscope_promo_poster.jpg`}
                width="720"
                height="1280"
                loop
                playsinline
                controls
                preload="none"
                class="shelfvideo"
                aria-label="SubScope の紹介動画。AYNがサブスクの解約忘れを防ぐ使い方を案内する縦型プロモ。"
              ></video>
              <video
                data-lazyvideo
                data-src={`${base}/media/scene_night_loop.mp4`}
                poster={`${base}/media/scene_night_poster.jpg`}
                width="720"
                height="1080"
                muted
                loop
                playsinline
                preload="none"
                class="shelfvideo shelfvideo--scene"
                aria-label="星空の下で『おやすみー！』と手を伸ばすAYNの水彩アニメーション。"
              ></video>
            </HScroll>
          </div>
        </>
      )}
    </Section>

    <Section
      id="listen"
      tone="teal"
      harbor="RADIO HARBOR"
      harborLabel="聴く港"
      harborAyn="ayn_radio"
      eyebrow="Radio & YouTube"
      title="聴く・眠る・作業する"
      lead="眠れん夜のBGM、手が止まらんための作業BGM、朝のトークラジオ。ぼんやり流してほしか。"
      mist={true}
      avatar={aynNight}
      avatarAlt="おやすみのAYN"
    >
      {/* AYN の放送ブース。机の機材がそれぞれ動く・ミキサーの 4 本＝4 局（Hairline・試作 2026-10-27） */}
      <div class="hlf-slot hlf-slot--wide"><HairlineFigure name="studio" label="AYN の放送ブース。ラックサーバー・モニター・キーボード・ミキサー・マイク・ヘッドホンなどがあって、指した機材が動く。ミキサーの 4 本のフェーダーは sleep・work・radio・ai radio の 4 局" /></div>
      <LatestVideo />
      <div>
        <HScroll label="チャンネル一覧" size="card" hint={`${channels.length}チャンネル`}>
          {channels.map((ch) => (
            <Card
              title={ch.data.title}
              summary={ch.data.summary}
              url={ch.data.url}
              cta={ch.data.cta}
              handle={ch.data.handle}
              image={ch.data.image}
            />
          ))}
        </HScroll>
      </div>
    </Section>

    <Section
      id="music"
      tone="purple"
      harbor="MUSIC HARBOR"
      harborLabel="音の港"
      harborAyn="ayn_music"
      eyebrow="Music"
      title="音楽配信"
      lead="Apple Music・Spotify ほか、好きなところで聴けるばい。気分から選んでもよか。"
      avatar={aynExcited}
      avatarAlt="うれしそうなAYN"
    >
      <MoodPicker />
      <div>
        <HScroll label="EP・アルバム" title="EP・アルバム" size="card" hint={`${musicEps.length}件`} trackAttr="data-music-grid">
          {musicEps.map((m) => (
            <Card
              title={m.data.title}
              summary={m.data.summary}
              url={m.data.url}
              cta={m.data.cta}
              badge={m.data.service}
              image={m.data.image}
              moods={m.data.moods}
            />
          ))}
        </HScroll>
      </div>

      {musicSingles.length > 0 && (
        <div>
          <HScroll label="シングル" title="シングル" size="card" hint={`${musicSingles.length}件`} trackAttr="data-music-singles">
            {musicSingles.map((m) => (
              <Card
                title={m.data.title}
                summary={m.data.summary}
                url={m.data.url}
                cta={m.data.cta}
                badge={m.data.service}
                image={m.data.image}
                moods={m.data.moods}
              />
            ))}
          </HScroll>
        </div>
      )}
    </Section>

    <Section
      id="sns"
      tone="rose"
      harbor="SIGNAL HARBOR"
      harborLabel="便りの港"
      harborAyn="ayn_social"
      eyebrow="Social"
      title="航海日誌・リンク"
      lead="日々の記録はこっち。気が向いたら覗いてほしか。"
      mist={true}
      avatar={aynSmile}
      avatarAlt="ほほえむAYN"
    >
      <Feed />

      {/* 灯台がわりの2本: 全リンクまとめ（名刺）と、YouTube は Radio 港にあるという案内 */}
      <div class="pins">
        {pinned.map((s) => (
          <a class="pins__pin pins__pin--strong" href={s.data.url} target="_blank" rel="noopener noreferrer">
            {s.data.title}
          </a>
        ))}
        <a class="pins__pin" href="#listen">YouTube（3チャンネル）は Radio 港に</a>
      </div>

      <div>
        <HScroll label="発信先とリンク" size="card" hint={`${primarySocial.length}件`}>
          {primarySocial.map((s) => (
            <Card
              title={s.data.title}
              summary={s.data.summary}
              url={s.data.url}
              cta={s.data.cta}
              handle={s.data.handle}
              image={s.data.image}
            />
          ))}
        </HScroll>
      </div>

      {/* いまは空（SNS はぜんぶ上の棚に画像つきカードで出しとる）。
          リンクが増えすぎた時に .md の tier を more に落とせば、
          ここに一段小さいピルの棚として逃がせる＝受け皿として残しとる。 */}
      {moreSocial.length > 0 && (
        <div class="routes" data-reveal="up">
          <HScroll
            label="その他の航路"
            size="pill"
            title="その他の航路"
            hint={`More Routes・${moreSocial.length}件`}
          >
            {moreSocial.map((s) => (
              <a class="routes__pill" href={s.data.url} target="_blank" rel="noopener noreferrer">
                <b>{s.data.title}</b>
                {s.data.handle && <span>{s.data.handle}</span>}
                <em>{s.data.summary}</em>
              </a>
            ))}
          </HScroll>
        </div>
      )}
    </Section>

    <Section
      id="engine"
      tone="amber"
      harbor="ENGINE ROOM"
      harborLabel="フネの心臓部"
      harborAyn="ayn_engine"
      eyebrow="Engine Room"
      title="機関室"
      lead="フネの心臓部。ぼくが毎日の整備を「AYN の機関日誌」に書きとめとるよ。"
      avatar={aynThinking}
      avatarAlt="考えごとをするAYN"
    >
      <div class="enginelog" data-reveal="up">
        {recentLogs.length > 0 ? (
          <div class:list={['enginelog__window', { 'is-scroll': logScrolls }]}>
          <ul
            class="enginelog__list"
            tabindex={logScrolls ? 0 : undefined}
            aria-label={logScrolls ? 'AYN の機関日誌（窓の中をスクロールできます）' : undefined}
            data-enginelog
          >
            {recentLogs.map((e) => (
              <li>
                <a href={`${base}/engine-room/#${logAnchor(e.data.date)}`}>
                  <span class="enginelog__date"><Icon name="wrench" /> {fmtLogDate(e.data.date)}</span>
                  <span class="enginelog__title">{e.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          </div>
        ) : (
          <p class="enginelog__empty">日誌はまだ白紙ばい。</p>
        )}
        {logScrolls && <p class="enginelog__hint" aria-hidden="true"><Icon name="updown" /> 窓の中をスクロールすると、前の日誌も読めるばい</p>}
        <a class="pins__pin pins__pin--strong enginelog__more" href={`${base}/engine-room/`}>
          機関室に入る{allLogs.length > LOG_WINDOW_MAX ? '（ぜんぶの日誌）' : ''}
        </a>
      </div>
    </Section>

    <About />
    <Contact />
    {/* フネのしるし：ロゴを大きく 1 つ。指を当てた所が持ち上がる（試作 2026-10-27） */}
    <ShipMark />
  </main>
  <Footer />
  <AynNavigator />
  <LazyVideos />
  <Reveal />
</BaseLayout>

<script>
  // 機関日誌の窓: 一番下まで読んだら下端の霧を消す
  for (const list of document.querySelectorAll<HTMLElement>('[data-enginelog]')) {
    const win = list.parentElement;
    if (!win?.classList.contains('is-scroll')) continue;
    const update = () => win.classList.toggle('is-end', list.scrollTop + list.clientHeight >= list.scrollHeight - 4);
    list.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<script>
  // ショートカット集の帯：画面に入ったら is-in を付けて、カットインを 1 回だけ流す
  (() => {
    const band = document.querySelector('[data-scband]');
    if (!band) return;
    if (!('IntersectionObserver' in window)) { band.classList.add('is-in'); return; }
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        band.classList.add('is-in');
        io.disconnect();
      }
    }, { threshold: 0.6 });
    io.observe(band);
    // 見張りが一度も呼ばれん環境の保険：止まった帯で出す
    setTimeout(() => band.classList.add('is-in'), 8000);
  })();
</script>

<style>
  /* 港の動く線画（Hairline）の置き場所 */
  .hlf-slot { max-width: 420px; margin: 0 auto 1.6rem; }
  .hlf-slot--wide { max-width: 560px; }
  /* Other Apps などの小見出し（港の中の区切り） */
  .subhead {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--c-ink);
    margin: 0 0 clamp(0.9rem, 2.5vw, 1.3rem);
  }
  .subhead__en {
    font-size: 0.75rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--sw-ink-strong, var(--c-blue-deep));   /* 紙の上で 4.0 しか出とらんかった */
    opacity: 0.85;
  }

  /* 灯台がわりのピル（名刺・YouTube 案内） */
  .pins {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 0 0 clamp(1.1rem, 3vw, 1.6rem);
  }
  .pins__pin {
    font-size: 0.85rem;
    padding: 0.42em 1em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid var(--c-line);
    color: var(--c-ink-soft);
    box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .pins__pin:hover { transform: translateY(-2px); border-color: var(--c-blue); color: var(--c-blue-deep); text-decoration: none; }
  .pins__pin--strong {
    background: var(--grad-ink);
    color: #fff;
    border-color: transparent;
  }
  .pins__pin--strong:hover { color: #fff; }

  /* その他の航路（畳まん・カードより一段小さい扱い） */
  .routes {
    margin: clamp(1.2rem, 3vw, 1.8rem) auto 0;
    background: rgba(255, 255, 255, 0.55);
    border: 1px dashed var(--c-line);
    border-radius: 14px;
    padding: 0.8rem 0.9rem 0.3rem;
  }
  .routes__pill {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.35;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--c-line);
    background: #fff;
    color: var(--c-ink);
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
    height: 100%;
  }
  .routes__pill:hover { border-color: var(--c-blue); transform: translateY(-2px); text-decoration: none; }
  .routes__pill b { font-size: 0.88rem; font-weight: 600; }
  .routes__pill span { font-size: 0.75rem; color: var(--c-ink-soft); font-family: var(--font-display); }
  .routes__pill em {
    font-style: normal;
    font-size: 0.75rem;
    color: var(--c-ink-soft);
    margin-top: 0.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 機関室の予告（日誌の新しい 3 本） */
  .enginelog {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .enginelog__window {
    position: relative;
    margin: 0 0 1rem;
    background: var(--c-card);
    border: 1px solid var(--c-line);
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }
  .enginelog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }
  /* 窓: 約 5 本ぶん（1 行 ≒ 3rem）。中身が多い時だけスクロール。
     overscroll-behavior で、窓の端まで来てもページごと流れ出さん（スマホの二重スクロール対策） */
  .enginelog__window.is-scroll .enginelog__list {
    max-height: 15.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--c-blue) transparent;
  }
  .enginelog__window.is-scroll .enginelog__list:focus-visible { outline: 2px solid var(--c-blue); outline-offset: -2px; }
  /* 下に続きがある合図（下端のうっすら霧）。最後まで読んだら消える */
  .enginelog__window.is-scroll::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.2rem;
    pointer-events: none;
    background: linear-gradient(transparent, var(--c-card));
    transition: opacity 0.2s ease;
  }
  .enginelog__window.is-end::after { opacity: 0; }
  .enginelog__hint {
    margin: -0.5rem 0 0.9rem;
    font-size: 0.75rem;
    color: var(--c-ink-soft);
  }
  .enginelog__list li + li { border-top: 1px dashed var(--c-line); }
  .enginelog__list a {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    color: var(--c-ink);
  }
  .enginelog__list a:hover { text-decoration: none; color: var(--c-blue-deep); }
  .enginelog__date {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--c-blue-deep);
  }
  .enginelog__title { min-width: 0; }
  .enginelog__empty { color: var(--c-ink-soft); }
  .enginelog__more { display: inline-block; }

  /* 横に流す動画棚 */
  .shelf { margin-top: clamp(1.4rem, 4vw, 2.2rem); }
  .shelfvideo {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: 14px;
    background: #0d1330;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-soft);
    display: block;
  }
  .shelfvideo--scene { aspect-ratio: 2 / 3; }

