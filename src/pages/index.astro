---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VoyagerCounter from '../components/VoyagerCounter.astro';
import VoyageRail from '../components/VoyageRail.astro';
import AynNavigator from '../components/AynNavigator.astro';
import LazyVideos from '../components/LazyVideos.astro';
import LatestVideo from '../components/LatestVideo.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Featured from '../components/Featured.astro';
import MoodPicker from '../components/MoodPicker.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Feed from '../components/Feed.astro';
import Footer from '../components/Footer.astro';

// 見出しの丸AYN・大きな水彩シーン
import aynOk from '../assets/ayn/ayn-ok.png';
import aynNight from '../assets/ayn/ayn-night.png';
import aynExcited from '../assets/ayn/ayn-excited.png';
import aynSmile from '../assets/ayn/ayn-smile.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const visible = (e: { data: { status: string; order: number } }) =>
  e.data.status !== 'hidden' && e.data.status !== 'draft';
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const apps = (await getCollection('apps')).filter(visible).sort(byOrder);
const channels = (await getCollection('channels')).filter(visible).sort(byOrder);
const music = (await getCollection('music')).filter(visible).sort(byOrder);
const social = (await getCollection('social')).filter(visible).sort(byOrder);

// Apps 港の主役（featured: true の1本）。残りは Other Apps。
// 主役を替えるのは .md の featured を付け替えるだけ（コードは触らんでよか）。
const featured = apps.find((a) => a.data.featured);
const otherApps = apps.filter((a) => a !== featured);

// SNS は強さで3段（pinned=ピル / primary=カード / more=その他の航路）
const pinned = social.filter((s) => s.data.tier === 'pinned');
const primarySocial = social.filter((s) => s.data.tier === 'primary');
const moreSocial = social.filter((s) => s.data.tier === 'more');
---
<BaseLayout>
  <VoyageRail />
  <Hero />
  <VoyagerCounter />
  <main id="main">
    <Section
      id="apps"
      harbor="APPS HARBOR"
      eyebrow="Apps"
      title="つくったアプリ"
      lead="ぼくが機関室から手伝いよる、iPhone アプリたち。ぜんぶ無料で始められるばい。"
      avatar={aynOk}
      avatarAlt="サムズアップするAYN"
    >
      {featured && (
        <Featured
          title={featured.data.title}
          hook={featured.data.hook}
          summary={featured.data.summary}
          url={featured.data.url}
          cta={featured.data.cta}
          badge={featured.data.price}
          icon={featured.data.icon}
          demo={featured.data.demo ? `${base}${featured.data.demo}` : undefined}
          demoPoster={featured.data.demoPoster ? `${base}${featured.data.demoPoster}` : undefined}
          extraLinks={featured.data.extraLinks}
        />
      )}

      {otherApps.length > 0 && (
        <>
          <h3 class="subhead">
            <span class="subhead__en">Other Apps</span>
            もう動きよるアプリ
          </h3>
          <div class="feature">
            <div class="feature__art feature__art--video">
              <video
                data-lazyvideo
                data-src={`${base}/media/shiftwake_promo.mp4`}
                poster={`${base}/media/shiftwake_promo_poster.jpg`}
                width="720"
                height="1280"
                muted
                loop
                playsinline
                preload="none"
                aria-label="ShiftWake の紹介動画。AYNがシフト自動アラームの使い方を案内する縦型プロモ。"
              ></video>
              <video
                data-lazyvideo
                data-src={`${base}/media/fuyo_promo.mp4`}
                poster={`${base}/media/fuyo_promo_poster.webp`}
                width="720"
                height="1280"
                muted
                loop
                playsinline
                preload="none"
                aria-label="扶養メーターの紹介動画。AYNがアプリの使い方を案内する縦型プロモ。"
              ></video>
            </div>
            <div class="grid">
              {otherApps.map((app) => (
                <Card
                  title={app.data.title}
                  summary={app.data.summary}
                  url={app.data.url}
                  cta={app.data.cta}
                  badge={app.data.price}
                  icon={app.data.icon}
                />
              ))}
            </div>
          </div>
        </>
      )}
    </Section>

    <Section
      id="listen"
      harbor="RADIO HARBOR"
      eyebrow="Radio & YouTube"
      title="聴く・眠る・作業する"
      lead="眠れん夜のBGM、手が止まらんための作業BGM、朝のトークラジオ。ぼんやり流してほしか。"
      mist={true}
      avatar={aynNight}
      avatarAlt="おやすみのAYN"
    >
      <LatestVideo />
      <div class="feature feature--reverse">
        <div class="grid">
          {channels.map((ch) => (
            <Card
              title={ch.data.title}
              summary={ch.data.summary}
              url={ch.data.url}
              cta={ch.data.cta}
              handle={ch.data.handle}
              image={ch.data.image}
            />
          ))}
        </div>
        <div class="feature__art">
          <video
            data-lazyvideo
            data-src={`${base}/media/scene_night_loop.mp4`}
            poster={`${base}/media/scene_night_poster.jpg`}
            width="720"
            height="1080"
            muted
            loop
            playsinline
            preload="none"
            aria-label="星空の下で『おやすみー！』と手を伸ばすAYNの水彩アニメーション。"
          ></video>
        </div>
      </div>
    </Section>

    <Section
      id="music"
      harbor="MUSIC HARBOR"
      eyebrow="Music"
      title="音楽配信"
      lead="Apple Music・Spotify ほか、好きなところで聴けるばい。気分から選んでもよか。"
      avatar={aynExcited}
      avatarAlt="うれしそうなAYN"
    >
      <MoodPicker />
      <div class="grid" data-music-grid>
        {music.map((m) => (
          <Card
            title={m.data.title}
            summary={m.data.summary}
            url={m.data.url}
            cta={m.data.cta}
            badge={m.data.service}
            image={m.data.image}
            moods={m.data.moods}
          />
        ))}
      </div>
    </Section>

    <Section
      id="sns"
      harbor="SIGNAL HARBOR"
      eyebrow="Social"
      title="航海日誌・リンク"
      lead="日々の記録はこっち。気が向いたら覗いてほしか。"
      mist={true}
      avatar={aynSmile}
      avatarAlt="ほほえむAYN"
    >
      <Feed />

      {/* 灯台がわりの2本: 全リンクまとめ（名刺）と、YouTube は Radio 港にあるという案内 */}
      <div class="pins">
        {pinned.map((s) => (
          <a class="pins__pin pins__pin--strong" href={s.data.url} target="_blank" rel="noopener noreferrer">
            {s.data.title}
          </a>
        ))}
        <a class="pins__pin" href="#listen">YouTube（3チャンネル）は Radio 港に</a>
      </div>

      <div class="grid">
        {primarySocial.map((s) => (
          <Card
            title={s.data.title}
            summary={s.data.summary}
            url={s.data.url}
            cta={s.data.cta}
            handle={s.data.handle}
            image={s.data.image}
          />
        ))}
      </div>

      {moreSocial.length > 0 && (
        <details class="routes">
          <summary>
            <span class="routes__en">More Routes</span>
            その他の航路（{moreSocial.length}）
          </summary>
          <ul class="routes__list">
            {moreSocial.map((s) => (
              <li>
                <a href={s.data.url} target="_blank" rel="noopener noreferrer">
                  <b>{s.data.title}</b>
                  {s.data.handle && <span>{s.data.handle}</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </Section>

    <About />
    <Contact />
  </main>
  <Footer />
  <AynNavigator />
  <LazyVideos />
</BaseLayout>

<style>
  /* Other Apps などの小見出し（港の中の区切り） */
  .subhead {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--c-ink);
    margin: 0 0 clamp(0.9rem, 2.5vw, 1.3rem);
  }
  .subhead__en {
    font-size: 0.58rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--c-blue-deep);
    opacity: 0.85;
  }

  /* 灯台がわりのピル（名刺・YouTube 案内） */
  .pins {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 0 0 clamp(1.1rem, 3vw, 1.6rem);
  }
  .pins__pin {
    font-size: 0.85rem;
    padding: 0.42em 1em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid var(--c-line);
    color: var(--c-ink-soft);
    box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .pins__pin:hover { transform: translateY(-2px); border-color: var(--c-blue); color: var(--c-blue-deep); text-decoration: none; }
  .pins__pin--strong {
    background: var(--grad-accent);
    color: #fff;
    border-color: transparent;
  }
  .pins__pin--strong:hover { color: #fff; }

  /* その他の航路（畳んどく・消さん） */
  .routes {
    max-width: 720px;
    margin: clamp(1.2rem, 3vw, 1.8rem) auto 0;
    background: rgba(255, 255, 255, 0.72);
    border: 1px dashed var(--c-line);
    border-radius: 14px;
    padding: 0.7rem 1rem;
  }
  .routes > summary {
    cursor: pointer;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--c-ink-soft);
  }
  .routes > summary::marker { color: var(--c-blue); }
  .routes__en {
    font-family: var(--font-display);
    font-size: 0.56rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--c-blue-deep);
  }
  .routes__list {
    list-style: none;
    margin: 0.8rem 0 0.2rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }
  .routes__list a {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    padding: 0.45rem 0.7rem;
    border-radius: 10px;
    border: 1px solid var(--c-line);
    background: #fff;
    color: var(--c-ink);
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .routes__list a:hover { border-color: var(--c-blue); transform: translateY(-1px); text-decoration: none; }
  .routes__list b { font-size: 0.88rem; font-weight: 600; }
  .routes__list span { font-size: 0.7rem; color: var(--c-ink-soft); font-family: var(--font-display); }
</style>
