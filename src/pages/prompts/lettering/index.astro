---
// 海図帳・文字の棚（20 種の一覧）。画風の一覧と同じ見た目。
// カードを押すと統合モード（/prompts/compose/?lt=LT-xx）へ。プロンプトの組み立ては統合モードだけが持つ。
import KaizuShell from '../../../components/KaizuShell.astro';
import { LETTERING, STYLE, kaizuBase, kaizuImg, composeUrl } from '../../../lib/kaizu';

const fams = Object.entries(LETTERING.families) as [string, string][];
const famName = (k: string) => (LETTERING.families as Record<string, string>)[k] ?? k;
const sample = LETTERING.sample_text;
---
<KaizuShell
  title="文字の棚（20 種）｜海図帳 — AI 画像生成用のプロンプト集 — BCNOFNe"
  description="AI 画像生成で絵に文字を入れるプロンプト 20 種。筆文字・ネオン・ステンシル・刺繍・浮き輪文字など。入れる文字と大きさ・並べ方・縁取りを選んで、画風や場所と 1 本にまとめられる。"
>
  <header class="paper">
    <p class="kz-crumb"><a href={`${kaizuBase}/`}>海図帳</a> › 文字の棚</p>
    <h1>文字の棚（{LETTERING.items.length} 種）</h1>
    <p class="lead">AI 画像生成で、絵に文字を入れるためのプロンプト。書体の雰囲気を選び、入れる文字・大きさ・並べ方・縁取りを決めると 1 本にまとまる。書体を選ぶと、統合モード（画風・場所と組み合わせる欄）へ。</p>
    <p class="note"><a href={composeUrl()} style="display:inline-flex;align-items:center;min-height:44px">統合モード（ジャケ・サムネの組み立て）へ →</a></p>
    <p class="kz-terms">プロンプトは、ご自分の画像生成にご自由にお使いください（商用も可）。使う時に「BCNOFNe」の名前を添えてもらえると嬉しいです（任意）。見本の画像の転載・再配布はご遠慮ください。プロンプトで作った絵の権利や商用の可否は、お使いの画像生成サービスの規約に従います（当サイトが許すのはプロンプトの文までです）。入れる文字に他人の名前・商標・ロゴを無断で使わず、配信ジャケは配信先の決まりもご確認ください。使われ方を知るため、押されたボタンや開かれたページの番号・言語（混ぜた画風の組み合わせを含む）の回数だけを、当サイトの集計用サーバー（Cloudflare）に送って数えています。入れた文字は送らず、個人を特定する記録も残しません（IP アドレスは、送りすぎを防ぐために変換して 2 分だけ使い、すぐ消えます）。回数は最長 90 日で消え、Cookie や端末の識別子は使いません。</p>
    <figure class="kz-source" style="margin-top:0.9rem">
      <img src={kaizuImg(STYLE.source_img, 's')} alt="見本の元絵：夜の港の岩場にいる AYN" width="480" height="480" loading="eager" decoding="async" />
      <figcaption><b>見本の元絵</b><br />下の見本はすべて、画風の棚と同じこの 1 枚（BCNOFNe のキャラクター AYN・これも AI 画像生成で描いた絵）に、AI 画像生成で文字を入れたもの。大きい文字「{sample.main}」・小さい文字「{sample.sub}」で描いた見本。</figcaption>
    </figure>
  </header>

  <section class="paper" aria-label="絞り込み">
    <div class="kz-filter">
      <input type="search" id="kz-q" placeholder="探す：筆、ネオン、刺繍" aria-label="文字の書体を探す" />
    </div>
    <div class="kz-filter" style="margin-top:0.6rem" id="kz-fams">
      <button class="kz-chip" type="button" data-fam="" aria-pressed="true">すべて</button>
      {fams.map(([k, v]) => <button class="kz-chip" type="button" data-fam={k} aria-pressed="false">{v}</button>)}
    </div>
    <p class="kz-count" id="kz-count" style="margin-top:0.6rem">{LETTERING.items.length} / {LETTERING.items.length} 種</p>
  </section>

  <div class="kz-grid" id="kz-grid">
    {LETTERING.items.map((it, i) => (
      <a class="kz-card" href={composeUrl({ lt: it.id })} data-fam={it.family}
         data-hay={[it.name_ja, it.name_en, it.general_ja, it.number_ja, it.desc_ja, ...it.aliases].join(' ').toLowerCase()}>
        <img src={kaizuImg(it.img!, 's')} alt={`「${it.name_ja}」の見本（AYN の絵に文字を入れた絵）`} width="480" height="480" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
        <div class="kz-card__body">
          <p class="kz-card__no">文字の{it.number_ja}・{famName(it.family)}</p>
          <h2 class="kz-card__name">{it.name_ja}</h2>
          <p class="kz-card__gen">{it.general_ja}</p>
          <p class="kz-card__desc">{it.desc_ja}</p>
        </div>
      </a>
    ))}
  </div>
  <p class="paper" id="kz-empty" hidden>この条件に合う書体はありません。言葉を短くするか「すべて」に戻してください。</p>
</KaizuShell>

<script>
  // 絞り込み（画風の棚と同じ動き）
  const grid = document.getElementById('kz-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.kz-card'));
  const st = { q: '', fam: '' };
  const apply = () => {
    let n = 0;
    const words = st.q.toLowerCase().split(/\s+/).filter(Boolean);
    for (const c of cards) {
      const ok = (!st.fam || c.dataset.fam === st.fam) && words.every((w) => (c.dataset.hay || '').includes(w));
      c.hidden = !ok; if (ok) n++;
    }
    document.getElementById('kz-count')!.textContent = `${n} / ${cards.length} 種`;
    document.getElementById('kz-empty')!.hidden = n > 0;
  };
  document.getElementById('kz-q')!.addEventListener('input', (e) => { st.q = (e.target as HTMLInputElement).value.trim(); apply(); });
  const famBox = document.getElementById('kz-fams')!;
  famBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-fam]'); if (!b) return;
    st.fam = b.dataset.fam || '';
    famBox.querySelectorAll('[data-fam]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  });
</script>
