---
// /en — 外国から来た人の着地点（Prompt259）。全訳やなく「今すぐ消費できる資産」への導線1枚。
// 英語は書き下ろし（機械翻訳せん・博多弁の機微は載せん）。トーンの正本は Substack "Ship's Log of BCNOFNe"。
// 載せんもの: 扶養メーター（日本の税制専用）・LINE・楽天ROOM・日本語トークの Radio/Podcast・重いロア。
// 日本語ページ（/）には一切手を入れん。カードの中身は content/*.md を共有し、英語の文言だけここで持つ。
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import HScroll from '../../components/HScroll.astro';
import Footer from '../../components/Footer.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import Reveal from '../../components/Reveal.astro';
import keyVisual from '../../assets/ayn-keyvisual.png';
import aynNight from '../../assets/ayn/ayn-night.png';
import aynExcited from '../../assets/ayn/ayn-excited.png';
import aynThinking from '../../assets/ayn/ayn-thinking.png';
import aynOk from '../../assets/ayn/ayn-ok.png';
import aynSmile from '../../assets/ayn/ayn-smile.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── Sleep & Focus（言語不要＝最強の入口）。日本語トークの BCNOFNe Radio / Podcast は載せん ──
const sleepCh = await getEntry('channels', 'youtube-sleep-radio');
const workCh = await getEntry('channels', 'youtube-work-radio');
const bgm = [
  sleepCh && {
    title: 'AYN Sleep Radio',
    handle: sleepCh.data.handle,
    summary: 'Watercolor sleep music for nights when your mind won’t stop. Soft, slow, and long enough to drift off to.',
    url: sleepCh.data.url,
    image: sleepCh.data.image,
  },
  workCh && {
    title: 'AYN Work Radio',
    handle: workCh.data.handle,
    summary: 'Focus BGM for studying, coding, and deep work. No lyrics to pull your attention away.',
    url: workCh.data.url,
    image: workCh.data.image,
  },
].filter(Boolean) as { title: string; handle?: string; summary: string; url: string; image?: ImageMetadata }[];

// ── Music（DistroKid HyperFollow＝全ストアへ飛べる）。英語の一言は手書き、無ければ気分から ──
const MUSIC_EN: Record<string, string> = {
  'album-akari-no-mukou': 'Sleep EP No.3 — crossing a foggy sea by lantern light. The newest release.',
  'album-umi-no-akari': 'Sleep EP No.2 — lullabies wrapped in harbor lights.',
  'album-yonagi': 'Sleep EP No.1 — where it all began: a calm night sea.',
  'album-aoi-tabi': 'Road-trip EP No.4 — sea breeze and guitar for an early morning drive. 34 tracks.',
  'album-asa-e': 'Road-trip EP No.3 — foot on the pedal, heading into the dawn.',
  'album-kyoumo-shuppatsu': 'Road-trip songs to start the engine on a sunny day.',
  'album-compass': 'Road-trip EP No.1 — believe in today, head for tomorrow.',
};
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const visible = (e: { data: { status: string } }) => e.data.status === 'active';
const albums = (await getCollection('music'))
  .filter(visible)
  .filter((m) => m.id.startsWith('album-'))
  .sort(byOrder)
  .map((m) => ({
    title: m.data.title,
    url: m.data.url,
    image: m.data.image,
    summary:
      MUSIC_EN[m.id] ??
      (m.data.moods.includes('sleep') ? 'A sleep EP of soft instrumentals.' : 'An EP of songs for the road.'),
    badge: m.data.moods.includes('sleep') ? 'Sleep' : 'Road trip',
  }));
const SPOTIFY = 'https://open.spotify.com/artist/0fvizFlx3hEP1ODPBWfVzW';

// ── Ship's Log（英語ニュースレター）。サムネはカードと共有 ──
const shipsLog = await getEntry('social', 'substack');
const SUBSTACK = shipsLog?.data.url ?? 'https://bcnofnelog.substack.com';

// ── Apps：英語 UI があって海外ストアにあるものだけ ──
const shiftwake = await getEntry('apps', 'shiftwake');
const SHIFTWAKE_US = 'https://apps.apple.com/us/app/id6785128543';

// ── note / Social ──
const note = await getEntry('social', 'note');
const SOCIAL = [
  { label: 'X', handle: '@Aynyann', url: 'https://x.com/Aynyann' },
  { label: 'Instagram', handle: '@aynyan28', url: 'https://www.instagram.com/aynyan28' },
  { label: 'TikTok', handle: '@aynyan2828', url: 'https://www.tiktok.com/@aynyan2828' },
  { label: 'Bluesky', handle: 'aynyan.bsky.social', url: 'https://bsky.app/profile/aynyan.bsky.social' },
  { label: 'GitHub', handle: 'Aynyan2828', url: 'https://github.com/Aynyan2828' },
];
---
<BaseLayout
  lang="en"
  title="BCNOFNe — a one-person studio sailing with AYN, an AI engineer"
  description="BCNOFNe is a one-person studio building an AI character named AYN — and the music, apps, and tools that sail with her. Free sleep & focus music, small iOS apps, and a weekly build log in English."
  alternates={[
    { lang: 'ja', path: '/' },
    { lang: 'en', path: '/en/' },
    { lang: 'x-default', path: '/' },
  ]}
>
  <LangSwitch lang="en" />
  <header class="enhero">
    <div class="container enhero__inner">
      <div class="enhero__copy">
        <p class="enhero__eyebrow">BCNOFNe · “boku no fune” — my ship</p>
        <h1 class="enhero__title">Free music, small apps,<br />and a build log — from one small ship.</h1>
        <p class="enhero__lead">
          BCNOFNe is a one-person studio building an AI character named <strong>AYN</strong> —
          and the music, apps, and tools that sail with her.
          Free sleep &amp; focus music, small iOS apps, and a weekly build log in English.
        </p>
        <div class="enhero__cta">
          <a class="btn" href="#listen">Play sleep &amp; focus music</a>
          <a class="btn btn--ghost" href="#log">Read the Ship’s Log</a>
        </div>
      </div>
      <div class="enhero__art">
        <Image
          src={keyVisual}
          alt="Watercolor illustration of AYN, an AI ship’s engineer with blue-to-pink hair and red round glasses, under a night sky with shooting stars."
          widths={[320, 480, 640]}
          sizes="(max-width: 720px) 70vw, 420px"
          loading="eager"
          class="enhero__img"
        />
      </div>
    </div>
  </header>

  <main id="main">
    <Section
      id="about"
      tone="blue"
      eyebrow="Meet AYN"
      title="The engineer in the engine room"
      avatar={aynOk}
      avatarAlt="AYN giving a thumbs-up"
    >
      <p class="prose" data-reveal="up">
        AYN is an engineer-type AI character: a former sailor turned ship’s engineer,
        now running the “engine room” of this little studio. She’s the face of the music,
        the writing, and the things I build here — and my daily co-pilot.
      </p>
    </Section>

    <Section
      id="listen"
      tone="teal"
      eyebrow="Sleep & Focus Music"
      title="Just press play"
      lead="Watercolor sleep and work BGM on YouTube. No words, no language barrier."
      avatar={aynNight}
      avatarAlt="AYN in pajamas, saying good night"
    >
      <div class="grid grid--2" data-reveal-stagger>
        {bgm.map((c) => (
          <Card title={c.title} handle={c.handle} summary={c.summary} url={c.url} image={c.image} cta="Open on YouTube" />
        ))}
      </div>
    </Section>

    <Section
      id="music"
      tone="purple"
      eyebrow="Music"
      title="Original EPs, streaming worldwide"
      lead="Original EPs for sleep and for the road, on Spotify, Apple Music, and more."
      avatar={aynExcited}
      avatarAlt="AYN looking excited"
    >
      <div class="pins" data-reveal="up">
        <a class="pins__pin pins__pin--strong" href={SPOTIFY} target="_blank" rel="noopener noreferrer">Follow on Spotify</a>
      </div>
      <div>
        <HScroll label="EPs" size="card" hint={`${albums.length} EPs · each link opens every store`}>
          {albums.map((m) => (
            <Card title={m.title} summary={m.summary} url={m.url} image={m.image} badge={m.badge} cta="Listen" />
          ))}
        </HScroll>
      </div>
    </Section>

    <Section
      id="log"
      tone="amber"
      eyebrow="Newsletter"
      title="Ship’s Log of BCNOFNe"
      avatar={aynThinking}
      avatarAlt="AYN thinking"
    >
      <a class="logcard" href={SUBSTACK} target="_blank" rel="noopener noreferrer" data-reveal="up">
        {shipsLog?.data.image && (
          <Image
            src={shipsLog.data.image}
            alt=""
            widths={[320, 480, 640]}
            sizes="(max-width: 720px) 90vw, 320px"
            loading="lazy"
            class="logcard__img"
          />
        )}
        <div class="logcard__body">
          <p class="logcard__kicker">Weekly · in English · on Substack</p>
          <h3 class="logcard__title">A build log with no hype</h3>
          <p class="logcard__text">
            One real thing I made or broke that week — the script or prompt that fixed it,
            and what I still haven’t solved.
          </p>
          <span class="btn logcard__btn">Read on Substack</span>
        </div>
      </a>
    </Section>

    <Section
      id="apps"
      tone="blue"
      eyebrow="Apps"
      title="Small iOS apps"
      avatar={aynSmile}
      avatarAlt="AYN smiling"
    >
      <div class="grid grid--2" data-reveal-stagger>
        {shiftwake && (
          <Card
            title="ShiftWake"
            badge="Free to start · iOS 26"
            summary="Automatic alarms for shift workers. Put your shift symbols in your iPhone calendar, and ShiftWake sets the right alarm for each day — real alarms that ring even in Silent or Focus mode. English UI."
            url={SHIFTWAKE_US}
            icon={shiftwake.data.icon}
            cta="View on the App Store"
          />
        )}
        <Card
          title="Angleon"
          badge="In progress"
          summary="A tangled scribble of lines — spin it, and at just the right angle a drawing appears. The app is still being built; you can try the browser demo now."
          url={`${base}/angleon/play.html?lang=en`}
          cta="Try the browser demo"
        />
      </div>
    </Section>

    <Section
      id="more"
      tone="rose"
      eyebrow="More to read"
      title="Notes & daily logs"
      avatar={aynOk}
      avatarAlt="AYN giving a thumbs-up"
    >
      <div class="grid grid--2" data-reveal-stagger>
        {note && (
          <Card
            title="note"
            handle={note.data.handle}
            summary="Longer, behind-the-scenes build notes (Japanese, with automatic translation available)."
            url={note.data.url}
            image={note.data.image}
            cta="Read on note"
          />
        )}
        <div class="social" data-reveal="up">
          <p class="social__lead">
            Work-in-progress and daily notes on X, Instagram, TikTok, Bluesky, and GitHub.
          </p>
          <ul class="social__list">
            {SOCIAL.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <b>{s.label}</b><span>{s.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>
  </main>
  <Footer lang="en" />
  <Reveal />
</BaseLayout>

<style>
  .enhero {
    position: relative;
    color: #fff;
    padding-block: clamp(3rem, 9vw, 5.5rem);
    padding-top: clamp(4.8rem, 9vw, 5.5rem);   /* 右上の言語ボタン(44px)と一行目が重ならんように */
    background: linear-gradient(160deg, rgba(34, 43, 92, 0.9) 0%, rgba(58, 74, 134, 0.84) 55%, rgba(98, 88, 150, 0.8) 100%);
  }
  .enhero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .enhero__eyebrow { margin: 0 0 0.6rem; font-size: 0.85rem; letter-spacing: 0.08em; opacity: 0.92; }
  .enhero__title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.4vw, 2.6rem);
    line-height: 1.3;
    margin: 0 0 1rem;
  }
  .enhero__lead { font-size: 1.02rem; line-height: 1.75; margin: 0 0 1.4rem; max-width: 36em; }
  .enhero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  /* ゴーストは紺の上に乗るけん白で縁取る（紙の上用の既定色やとコントラストが足りん） */
  .enhero__cta .btn--ghost { color: #fff; border-color: rgba(255, 255, 255, 0.7); background: rgba(255, 255, 255, 0.08); }
  .enhero__img { width: 100%; height: auto; border-radius: 20px; box-shadow: 0 18px 40px rgba(10, 14, 40, 0.35); }
  @media (max-width: 720px) {
    .enhero__inner { grid-template-columns: 1fr; }
    .enhero__art { max-width: 320px; margin: 0 auto; }
  }

  .prose { max-width: 40em; margin: 0 auto; font-size: 1.05rem; line-height: 1.8; color: var(--c-ink); text-align: center; }

  .grid--2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1rem, 3vw, 1.5rem);
    max-width: 820px;
    margin: 0 auto;
  }

  .pins { display: flex; justify-content: center; margin: 0 0 clamp(1rem, 3vw, 1.4rem); }
  .pins__pin {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.92rem;
    padding: 0.42em 1.2em;
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease;
  }
  .pins__pin--strong { background: var(--grad-ink); color: #fff; }
  .pins__pin:hover { transform: translateY(-2px); text-decoration: none; }

  /* Ship's Log：このページの主役カード（横長） */
  .logcard {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.8rem);
    align-items: center;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 1.4rem);
    background: var(--c-card);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--c-ink);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .logcard:hover { transform: translateY(-3px); border-color: var(--c-blue); text-decoration: none; }
  .logcard__img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 14px; }
  .logcard__kicker { margin: 0 0 0.3rem; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-blue-deep); }
  .logcard__title { font-family: var(--font-display); font-size: 1.3rem; margin: 0 0 0.5rem; }
  .logcard__text { margin: 0 0 1rem; line-height: 1.7; color: var(--c-ink-soft); }
  @media (max-width: 620px) {
    .logcard { grid-template-columns: 1fr; }
    .logcard__img { max-width: 240px; margin: 0 auto; }
  }

  .social {
    background: var(--c-card);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 1.2rem;
  }
  .social__lead { margin: 0 0 0.8rem; color: var(--c-ink-soft); line-height: 1.65; font-size: 0.95rem; }
  .social__list { list-style: none; margin: 0; padding: 0; }
  .social__list li + li { border-top: 1px dashed var(--c-line); }
  .social__list a {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    align-items: center;
    min-height: 44px;
    color: var(--c-ink);
  }
  .social__list a:hover { color: var(--c-blue-deep); text-decoration: none; }
  .social__list span { font-size: 0.85rem; color: var(--c-ink-soft); overflow-wrap: anywhere; text-align: right; }
</style>
