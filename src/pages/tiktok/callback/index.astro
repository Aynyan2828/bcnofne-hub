---
// TikTok API for Business の認可の戻り先（Redirect URL）。
// 来たコードを画面に出すだけ。サーバーにもログにも送らん。
// コードの交換（トークン化）は Mac 側のスクリプトでやる。鍵はこのページに置かん。
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>TikTok 認可の戻り先｜BCNOFNe</title>
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; padding: 32px 16px; font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif; background: #f6f7fb; color: #1d2333; }
      @media (prefers-color-scheme: dark) { body { background: #12151d; color: #e6e9f2; } .box { background: #1c2130; border-color: #2c3346; } }
      main { max-width: 560px; margin: 0 auto; }
      h1 { font-size: 1.25rem; }
      .box { background: #fff; border: 1px solid #d9deea; border-radius: 10px; padding: 12px; word-break: break-all; font-family: ui-monospace, Menlo, monospace; font-size: .9rem; }
      button { margin-top: 12px; padding: 10px 16px; border-radius: 8px; border: 0; background: #2d5bd7; color: #fff; font-size: 1rem; }
      .note { font-size: .85rem; opacity: .75; }
    </style>
  </head>
  <body>
    <main>
      <h1>TikTok の認可コード</h1>
      <p id="msg">読み込み中…</p>
      <div class="box" id="code" hidden></div>
      <button id="copy" hidden>コピーする</button>
      <p class="note">このコードは数分で切れます。人に見せず、Mac のスクリプトに貼ってください。このページはコードをどこにも送りません。</p>
    </main>
    <script>
      const q = new URLSearchParams(location.search);
      const code = q.get('auth_code') || q.get('code');
      const err = q.get('error') || q.get('error_description');
      const msg = document.getElementById('msg')!;
      const box = document.getElementById('code')!;
      const btn = document.getElementById('copy') as HTMLButtonElement;
      if (code) {
        msg.textContent = '受け取りました。下のコードをコピーしてください。';
        box.textContent = code;
        box.hidden = false;
        btn.hidden = false;
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(code); btn.textContent = 'コピーした'; }
          catch { btn.textContent = 'コピーできんかった（長押しで選んでください）'; }
        });
        // アドレスバーと履歴からコードを消す
        history.replaceState(null, '', location.pathname);
      } else if (err) {
        msg.textContent = '認可されませんでした: ' + err;
      } else {
        msg.textContent = 'コードがありません。TikTok の認可画面から戻ってきた時だけ使うページです。';
      }
    </script>
  </body>
</html>
