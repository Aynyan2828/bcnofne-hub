---
// ページ全体の背景コラージュ（YouTube動画制作アセット）
// 固定レイヤー＝スクロールしても「机に散らばった写真」が背後に居続ける
import { Image } from 'astro:assets';
import c01 from '../assets/collage/cur-01-scene.webp';
import c02 from '../assets/collage/cur-02-Sail_On_Beneath_the_Star.webp';
import c03 from '../assets/collage/cur-03-scene.webp';
import c04 from '../assets/collage/cur-04-Tide_Breathing_Out.webp';
import c05 from '../assets/collage/cur-05-scene.webp';
import c06 from '../assets/collage/cur-06-Silver_Mudflat.webp';
import c07 from '../assets/collage/cur-07-scene.webp';
import c08 from '../assets/collage/cur-08-Harbour_Lantern.webp';
import c09 from '../assets/collage/cur-09-scene.webp';
import c10 from '../assets/collage/cur-10-Lanterns_on_the_Ariake.webp';
import c11 from '../assets/collage/p2-01-scene.webp';
import c12 from '../assets/collage/p2-02-The_Tide_Lays_Down.webp';
import c13 from '../assets/collage/p2-03-_.webp';
import c14 from '../assets/collage/p2-04-The_Lighthouse_Turns.webp';
import c15 from '../assets/collage/p2-05-scene.webp';
import c16 from '../assets/collage/p2-06-Starfield_Anchorage.webp';
import c17 from '../assets/collage/p2-07-scene.webp';
import c18 from '../assets/collage/p2-08-The_Harbor_Holds.webp';

// 座標直書き（ビルド毎に変わらない・ここを編集して微調整）
// x/y=vw/vh基準%, rot=deg, w=幅vw, z=重なり, mobile:falseはモバイル非表示
//
// 視差(parallax): z=1 を「奥」、z=2 を「手前」として2層に束ねる。
// 束ごとに transform を1回書き換えるだけにしとる（写真18枚を個別に
// 動かすと毎フレーム18回のスタイル再計算になるけん）。動かすのは
// SeaBackdrop の描画ループ。奥はゆっくり、手前は速く流れる。
const ITEMS = [
  { img: c01, x: -4, y: -5, rot: -8.5, w: 20, z: 1, mobile: true },
  { img: c02, x: 15, y: 2, rot: 12.0, w: 15, z: 2, mobile: false },
  { img: c03, x: 34, y: -6, rot: -15.5, w: 22, z: 1, mobile: true },
  { img: c04, x: 58, y: 0, rot: 6.5, w: 16, z: 2, mobile: false },
  { img: c05, x: 78, y: -4, rot: 15.0, w: 24, z: 1, mobile: true },
  { img: c06, x: -6, y: 26, rot: 14.0, w: 24, z: 1, mobile: true },
  { img: c07, x: 18, y: 32, rot: -4.0, w: 15, z: 2, mobile: false },
  { img: c08, x: 38, y: 28, rot: 9.5, w: 18, z: 1, mobile: false },
  { img: c09, x: 60, y: 34, rot: -13.0, w: 20, z: 2, mobile: true },
  { img: c10, x: 84, y: 28, rot: 7.0, w: 20, z: 1, mobile: true },
  { img: c11, x: -3, y: 58, rot: -16.0, w: 18, z: 2, mobile: true },
  { img: c12, x: 16, y: 64, rot: 5.0, w: 22, z: 1, mobile: false },
  { img: c13, x: 42, y: 60, rot: 17.0, w: 16, z: 1, mobile: true },
  { img: c14, x: 62, y: 66, rot: -7.5, w: 22, z: 2, mobile: false },
  { img: c15, x: 85, y: 58, rot: 11.5, w: 18, z: 1, mobile: true },
  { img: c16, x: 6, y: 84, rot: 9.0, w: 20, z: 1, mobile: true },
  { img: c17, x: 36, y: 88, rot: -12.5, w: 18, z: 2, mobile: false },
  { img: c18, x: 68, y: 86, rot: 14.5, w: 22, z: 1, mobile: true },
];
---
<div class="pagecollage" aria-hidden="true">
  {[
    { z: 1, par: 0.06 },  // 奥の束: ゆっくり
    { z: 2, par: 0.14 },  // 手前の束: すこし速く
  ].map((layer) => (
    <div class="pagecollage__layer" style={`z-index:${layer.z};`} data-par={layer.par}>
      {ITEMS.filter((it) => it.z === layer.z).map((it) => (
        <div
          class:list={['pagecollage__item', { 'pagecollage__item--desktop': !it.mobile }]}
          style={`left:${it.x}vw; top:${it.y}vh; width:${it.w}vw; --rot:${it.rot}deg;`}
        >
          <Image src={it.img} alt="" width={560} height={315} loading="lazy" />
        </div>
      ))}
    </div>
  ))}
  <!-- 沖へ出るほど濃くなる霧。深さ(--fog)は VoyageRail が港ごとに更新する。
       白ベールの上に重なる別レイヤーやけん、港0では opacity:0＝いまの見た目のまま。
       動かすのは opacity だけ（合成のみ・再レイアウトせん）。 -->
  <span class="pagecollage__fog"></span>
</div>

<style>
  .pagecollage {
    position: fixed;
    inset: 0;
    z-index: -1; /* 全コンテンツの背面 */
    pointer-events: none;
    overflow: hidden;
  }
  /* 視差の束。中身は今までどおり絶対配置。
     will-change で合成レイヤーに乗せて、transform だけで動かす。
     縦に流すぶん、上下に余裕を持たせて端が見切れんようにする。 */
  .pagecollage__layer {
    position: absolute;
    inset: -20vh 0;
    will-change: transform;
  }
  .pagecollage__item {
    position: absolute;
    transform: rotate(var(--rot));
    background: #fff;
    padding: 0.4vw;
    border-radius: 6px;
    box-shadow: 0 8px 22px -8px rgba(31, 37, 64, 0.35);
    line-height: 0;
  }
  .pagecollage__item :global(img) {
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  /* 写真は「情報の海に浮かぶ思い出」の扱い。1枚も減らさんかわりに
     透かして、奥の海・粒子が通るようにする。ここも濃さの調整点。 */
  .pagecollage__item { opacity: 0.68; }
  /* 夜の scrim: 地が夜空になったけん、白で飛ばさず逆に沈める。
     写真が「夜の海に浮かぶ思い出」に見える濃さ。本文の読みやすさは
     セクションの紙だまりが持つけん、ここは白くせんでよか。 */
  .pagecollage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4; /* 写真(z1-2)より上 */
    background: linear-gradient(
      180deg,
      rgba(18, 24, 54, 0.34) 0%,
      rgba(22, 29, 62, 0.26) 45%,
      rgba(18, 24, 54, 0.34) 100%
    );
  }

  /* 霧のレイヤー（白ベール z:4 より上） */
  .pagecollage__fog {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(206, 220, 246, 0.9) 0%,
      rgba(222, 230, 250, 0.75) 45%,
      rgba(200, 212, 242, 0.85) 100%
    );
    opacity: calc(var(--fog, 0) * 0.42);
    transition: opacity 1.6s ease;
  }
  /* 夜はもう少しだけ青紫に沈む */
  html[data-tide='night'] .pagecollage__fog {
    background: linear-gradient(
      180deg,
      rgba(196, 208, 242, 0.92) 0%,
      rgba(210, 214, 246, 0.78) 45%,
      rgba(190, 200, 238, 0.88) 100%
    );
    opacity: calc(0.08 + var(--fog, 0) * 0.46);
  }

  @media (max-width: 720px) {
    .pagecollage__item--desktop { display: none; }
    .pagecollage__item {
      transform: rotate(calc(var(--rot) * 0.55));
      min-width: 34vw;
    }
  }
</style>
