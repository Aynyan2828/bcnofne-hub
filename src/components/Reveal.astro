---
/**
 * Reveal — 「ふわっと湧く／横から入る」到着演出の裏方（1ページに1つ置くだけ）
 *
 * 要素に属性を足すだけで効く:
 *   data-reveal="up"     下からふわっと湧く（既定）
 *   data-reveal="left"   左からすーっと入る
 *   data-reveal="right"  右からすーっと入る
 *   data-reveal-stagger  子要素を1枚ずつ順に湧かせる（カードの束に）
 *
 * CSS は global.css 側（複数コンポーネントで使うけん）。
 * IntersectionObserver は1つだけ。出したら監視を外すけん残らん。
 * JS が無い時は最初から見えとる（global.css が html.has-js の時だけ伏せる）。
 * prefers-reduced-motion では動かさず、その場に静かに置いとく。
 *
 * ★クローラー対策: 伏せる＝opacity:0 やけん、IO が動かん環境では本文が
 *   見えんままになる（＝検索エンジンに「隠しテキスト」と取られかねん）。
 *   そこで IO が一度も呼ばれんかったら 2.5 秒で演出を捨てて全部出す。
 */
---
<script>
  (() => {
    const init = () => {
      const targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
      if (!targets.length) return;

      // 演出なしで、その場に静かに置く
      const showAll = (els) => {
        for (const el of els) {
          if (el.hasAttribute('data-reveal-stagger')) for (const k of el.children) k.classList.add('is-in');
          el.classList.add('is-in');
        }
      };

      // 動きを減らす設定 / IO が無い環境: 伏せずに全部そのまま出す
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        showAll(targets);
        return;
      }

      // IO が一度でも呼ばれたか。呼ばれん環境＝伏せたままになるけん、
      // その時は演出を諦めて全部出す（クローラー対策としても重要）。
      let ioAlive = false;

      const io = new IntersectionObserver(
        (entries) => {
          ioAlive = true;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target;
            io.unobserve(el);
            if (el.hasAttribute('data-reveal-stagger')) {
              // 1枚ずつ、ほんの少し遅らせて湧かせる（最大 0.42 秒まで）
              let i = 0;
              for (const k of el.children) {
                k.style.transitionDelay = Math.min(i * 70, 420) + 'ms';
                k.classList.add('is-in');
                i++;
              }
            }
            el.classList.add('is-in');
          }
        },
        // 画面の下から少し入ってきたら点く（入った瞬間やと気づかれん）
        { rootMargin: '0px 0px -7% 0px', threshold: 0.06 }
      );
      for (const el of targets) io.observe(el);

      /* 保険1（最重要）: IO が一度も呼ばれん環境では、演出を丸ごと諦めて
         全部そのまま出す。検索エンジンや AI クローラーの描画エンジン、
         裏タブ、IO を潰す拡張などが該当する。
         「ページが真っ白に見える」より、演出が無い方が100倍よか。 */
      setTimeout(() => {
        if (ioAlive) return;
        showAll(targets);
        io.disconnect();
        // 港の到着演出（VoyageRail が動かす）も道連れにせん
        for (const h of document.querySelectorAll('[data-harbor]')) h.classList.add('is-arrived');
      }, 2500);

      /* 保険2: IO は動いとるけど、何かの拍子に取り残された要素があったら、
         もう画面に届いとるものだけ静かに出す。 */
      setTimeout(() => {
        const stuck = [];
        for (const el of targets) {
          if (el.classList.contains('is-in')) continue;
          if (el.getBoundingClientRect().top < innerHeight * 1.2) stuck.push(el);
        }
        if (stuck.length) {
          showAll(stuck);
          for (const el of stuck) io.unobserve(el);
        }
      }, 5000);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
  })();
</script>
