---
/**
 * HarborGate — 港の入口。「着いた」が分かる一画面。
 *
 * みさとと式に寄せるための一手。いまのサイトは「動く背景の上に普通のページが
 * 乗っとる」状態やった。港の手前に **海と空だけの一画面** を挟むことで、
 *   航海（海だけ）→ 到着（港の名前が出る）→ 中身（カード）
 * という呼吸を作る。
 *
 * 出すもの:
 *   ・港の英字名（MUSIC HARBOR）を大きく。奥から手前に寄ってくる
 *   ・日本語の一行（音楽の港）
 *   ・水平線の細い線が左右に開く＝港が開く合図
 *
 * ★カードの追加しやすさは壊さん。ここは「港の入口」だけを持つ入れ物で、
 *   中身のカードは今までどおり src/content/*.md が正本。港を増やす時も
 *   src/lib/voyage.ts に1行 ＋ Section に harbor を渡すだけ。
 *
 * 高さは 62vh（スマホ）。1画面まるごと取ると、情報に辿り着くのが遠うなる。
 * 「海だけの間」は感じるけど、スクロールが苦にならん長さにしとる。
 */
interface Props {
  /** 英字の港名（例: MUSIC HARBOR） */
  harbor: string;
  /** 日本語の一行（例: 音楽の港） */
  label?: string;
  /** 港で迎える AYN の絵（public/world/<ayn>.webp）。無ければ出さん */
  ayn?: string;
  /** 港の色（文字）。Section から降りてくる */
  tone?: string;
  /** 港の id。背景の海に、この港の目印(public/world/port_<id>.webp)が浮かぶ */
  port?: string;
}
const { harbor, label, ayn, tone, port } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div data-gate data-port={port} data-tone={tone} class:list={["gate", ayn && "has-ayn"]}>
  <div class="gate__inner">
    <p class="gate__tag" data-type data-type-step="45">ARRIVING</p>
    {/* ★TypeText を通さず、ここで直に描く。別コンポーネントが描いた要素には
        この入口のスコープ付き CSS（大きさ・白い縁取り・港の濃い色）が当たらん。
        一回それで港の名前が小さく薄くなった。 */}
    <p class="gate__name type" data-type="scramble">{harbor}</p>
    {label && <p class="gate__label" data-type data-type-delay="900" data-type-step="70">{label}</p>}
    <span class="gate__rule" aria-hidden="true"></span>
  </div>
  {ayn && (
    <img
      class="gate__ayn"
      src={`${base}/world/${ayn}.webp`}
      alt={`${harbor} で迎える AYN`}
      loading="lazy"
      decoding="async"
    />
  )}
</div>

<style>
  /* 文字のうしろにだけ淡い光だまりを敷く。港の入口は紙だまりの外やけん、
     これが無いと海の柄に文字が食われる。 */
  .gate::before {
    content: '';
    position: absolute;
    left: 50%;
    /* 文字は上寄りに置くけん（AYN が下半分に立つ）、光だまりも一緒に上げる */
    top: var(--gate-eye, 50%);
    transform: translate(-50%, -50%);
    width: min(92vw, 640px);
    height: min(46vh, 320px);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(251, 252, 255, 0.92),   /* 0.72→0.92: 文字の後ろを明るく（コントラスト） */
      rgba(251, 252, 255, 0.5) 55%,
      rgba(251, 252, 255, 0) 100%
    );
    pointer-events: none;
  }

  .gate {
    position: relative;
    overflow-x: clip;   /* 港の AYN を右に少しはみ出させとるけん、横だけ切る */
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    text-align: center;
    /* 港の入口は「海の上」。紙だまりを敷かんけん、ここだけ背景が素で見える */
    padding-inline: 1.2rem;
  }
  /* AYN が立つ港は、文字を上げて下半分を空ける（重なると両方読めん） */
  .gate.has-ayn {
    --gate-eye: 30%;
    justify-content: flex-start;
    padding-top: 8vh;
    /* ★入口とその港の中身は同じ港。港の名前から「つくったアプリ」まで
       海が1画面まるごと空いとった（マスター: 間は空けんでよか）。
       AYN が立てる分だけ残して詰める。 */
    min-height: 50vh;
  }
  .gate__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  /* ★小さい文字は海の柄に負ける。白い光の縁を回して浮かせる
     （実機で ARRIVING と日本語の一行が読めんかった）。 */
  .gate__tag {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.34em;
    color: var(--sw-ink-strong, var(--c-ink));   /* 海の上で 2.0〜2.6 しか出とらんかった */
    opacity: 1;
    text-shadow:
      0 0 10px rgba(255, 255, 255, 0.95),
      0 0 22px rgba(255, 255, 255, 0.85);
  }

  /* 港の名前。奥から手前に寄ってくる＝近づいとる */
  .gate__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 8vw, 3.4rem);
    letter-spacing: 0.06em;
    line-height: 1.15;
    color: var(--sw-ink, var(--c-ink));   /* 港の濃い色（下の --sw-ink 差し替え） */
    text-shadow:
      0 0 14px rgba(255, 255, 255, 0.9),
      0 2px 26px rgba(255, 255, 255, 0.8);
  }

  /* 港の名前は海の上。紙用の色やと沈むけん、濃い方に差し替える。
     ★--sw-ink そのものを上書きすること。色を指定するだけやと、
     1文字ずつのアニメの最後が --sw-ink を名指ししとるけん戻されてしまう。 */
  .gate__name { --sw-ink: var(--sw-ink-strong, var(--c-ink)); }

  .gate__label {
    margin: 0.45rem 0 0;
    font-size: 0.98rem;
    color: var(--c-ink);
    text-shadow:
      0 0 10px rgba(255, 255, 255, 0.95),
      0 0 22px rgba(255, 255, 255, 0.85);
  }

  /* 水平線の細い線。着くと左右に開く＝港が開く */
  .gate__rule {
    display: block;
    width: min(70vw, 420px);
    height: 1px;
    margin-top: 1.1rem;
    background: linear-gradient(90deg, transparent, var(--c-blue-deep), transparent);
    opacity: 0.55;
    transform: scaleX(0.2);
    transform-origin: 50% 50%;
    transition: transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* 伏せるのは「演出を動かせる」時だけ（reveal と同じ約束）。
     JS が落ちても港の名前は読める。 */
  /* ★.gate__name はここに入れん。中の SweepText（色の帯）が出し入れする。
     二重にやると帯が走る前に文字がふわっと出てしまう。 */
  /* ARRIVING・港の名前・日本語の一行は TextFx が1文字ずつ出す
     （名前だけ JIZURA 式のスクランブル）。ここで伏せると二重になるけん伏せん。
     入口の側で動かすのは、水平線の線が開くのだけ。 */
  .gate.is-in .gate__rule { transform: scaleX(1); transition-delay: 0.25s; }

  @media (prefers-reduced-motion: reduce) {
    .gate__rule { transform: scaleX(1); transition: none; }
  }

  /* 港で迎える AYN。港の名前と喧嘩せんよう右下の隅に立たせる。
     文字は中央やけん、被らん位置に置いとる。 */
  .gate__ayn {
    position: absolute;
    right: max(0.5rem, env(safe-area-inset-right));
    bottom: 0;
    height: min(46vh, 340px);
    width: auto;
    object-fit: contain;
    object-position: bottom;
    pointer-events: none;
    filter: drop-shadow(0 8px 24px rgba(31, 37, 64, 0.28));
    /* 足元を霧に溶かす。海の上に「立っとる」より、霧から現れた方が嘘が無い */
    -webkit-mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
  }
  :global(html.reveal-on) .gate__ayn {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 1s ease, transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  :global(html.reveal-on) .gate.is-in .gate__ayn {
    opacity: 1;
    transform: none;
    transition-delay: 0.3s;   /* 港の名前が出たあとに現れる */
  }

  @media (max-width: 560px) {
    /* スマホは小さく。文字の邪魔をせん大きさに留める */
    .gate__ayn { height: min(30vh, 230px); right: -0.4rem; opacity: 0.95; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.reveal-on) .gate__ayn { opacity: 1; transform: none; }
  }

  @media (min-width: 900px) {
    .gate { min-height: 56vh; }
  }
</style>
