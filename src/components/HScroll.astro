---
/**
 * HScroll — 横に流れる棚（縦長対策の共通部品）
 *
 * 中に並べたカードや動画を横スクロールにする。縦に積むと1画面が
 * どこまでも伸びるけん、数が増える置き場（音楽・チャンネル・動画・
 * リンク集）はこれに入れる。
 *
 * - スマホ: そのまま指でスワイプ（ネイティブのスクロール）
 * - PC: ホバーできる端末だけ左右のボタンが出る。1画面ぶんずつ送る
 * - キーボード: 棚自体が tabindex=0＝矢印キーでスクロールできる
 * - 端まで行ったかを JS が見て、端だけ霧がかかる（まだ先があると分かる）
 * - prefers-reduced-motion: スムーススクロールをやめて一瞬で移動
 *
 * 使い方:
 *   <HScroll label="音楽作品" size="card" hint="8作品">
 *     <Card ... /> ...
 *   </HScroll>
 */
interface Props {
  /** スクリーンリーダー向けの棚の名前 */
  label: string;
  /** 1枚の幅のプリセット */
  size?: 'card' | 'video' | 'pill' | 'wide';
  /** 棚の上に出す小さな見出し（例: 紹介動画） */
  title?: string;
  /** 右肩に出す件数などの一言 */
  hint?: string;
  /** track に付ける data 属性（MoodPicker の絞り込み先など） */
  trackAttr?: string;
}
const { label, size = 'card', title, hint, trackAttr } = Astro.props;

// 1枚の幅。スマホでは「次がちょっと覗く」幅にして、横に続くのを分からせる。
const WIDTH: Record<string, string> = {
  card: 'min(72vw, 248px)',
  wide: 'min(84vw, 330px)',
  video: 'min(52vw, 186px)',
  pill: 'min(56vw, 200px)',
};
const trackProps = trackAttr ? { [trackAttr]: true } : {};
---
<div class="hs" data-hscroll style={`--hs-item: ${WIDTH[size] ?? WIDTH.card};`}>
  {(title || hint) && (
    <p class="hs__head">
      {title && <span class="hs__title">{title}</span>}
      {hint && <span class="hs__hint">{hint}</span>}
      <span class="hs__swipe" aria-hidden="true">横にスクロール →</span>
    </p>
  )}
  <div class="hs__frame">
    <button class="hs__nav hs__nav--prev" type="button" data-hs-prev aria-label={`${label}を前へ`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
    </button>
    <div class="hs__track" data-hs-track tabindex="0" role="group" aria-label={label} {...trackProps}>
      <slot />
    </div>
    <button class="hs__nav hs__nav--next" type="button" data-hs-next aria-label={`${label}を次へ`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>
</div>

<style>
  .hs { position: relative; }
  .hs__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    flex-wrap: wrap;
  }
  .hs__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--c-ink);
  }
  .hs__hint { font-size: 0.72rem; color: var(--c-ink-soft); }
  .hs__swipe {
    margin-left: auto;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--c-ink-soft);
    opacity: 0.75;
  }
  /* ボタンが出る画面では「横にスクロール →」は要らん */
  @media (hover: hover) and (min-width: 760px) {
    .hs__swipe { display: none; }
  }

  .hs__frame { position: relative; }

  .hs__track {
    display: flex;
    gap: clamp(0.7rem, 2vw, 1.1rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    /* カードの影が切れんよう上下に余白。左右は画面端まで流れて見えるように */
    padding: 4px 4px 0.9rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line) transparent;
  }
  .hs__track::-webkit-scrollbar { height: 6px; }
  .hs__track::-webkit-scrollbar-thumb { background: var(--c-line); border-radius: 999px; }
  .hs__track::-webkit-scrollbar-track { background: transparent; }
  .hs__track:focus-visible { outline: 3px solid var(--c-purple); outline-offset: 2px; border-radius: 10px; }

  /* 棚に入れた要素は1枚ぶんの幅で固定（縮まん・伸びん） */
  .hs__track > :global(*) {
    flex: 0 0 var(--hs-item);
    max-width: var(--hs-item);
    scroll-snap-align: start;
  }

  /* 端に霧: まだ先があると分かる。端まで行ったら消える（JS が data-at を書く） */
  .hs__frame::before,
  .hs__frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0.9rem;
    width: clamp(18px, 5vw, 36px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }
  .hs__frame::before {
    left: 0;
    background: linear-gradient(90deg, rgba(251, 252, 255, 0.92), rgba(251, 252, 255, 0));
  }
  .hs__frame::after {
    right: 0;
    background: linear-gradient(270deg, rgba(251, 252, 255, 0.92), rgba(251, 252, 255, 0));
  }
  .hs[data-at='middle'] .hs__frame::before,
  .hs[data-at='end'] .hs__frame::before { opacity: 1; }
  .hs[data-at='start'] .hs__frame::after,
  .hs[data-at='middle'] .hs__frame::after { opacity: 1; }

  /* 左右の送りボタン: 指で触る端末には出さん（スワイプが自然やけん） */
  .hs__nav { display: none; }
  @media (hover: hover) and (min-width: 760px) {
    .hs__nav {
      display: grid;
      place-items: center;
      position: absolute;
      top: calc(50% - 0.45rem);
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--c-line);
      background: rgba(255, 255, 255, 0.92);
      color: var(--c-blue-deep);
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      z-index: 3;
      opacity: 0;
      transition: opacity 0.25s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hs__nav--prev { left: -6px; }
    .hs__nav--next { right: -6px; }
    .hs:hover .hs__nav,
    .hs:focus-within .hs__nav { opacity: 1; }
    .hs__nav:hover { box-shadow: var(--shadow); transform: translateY(-50%) scale(1.06); }
    /* 端に着いたら、その向きのボタンは消す */
    .hs[data-at='start'] .hs__nav--prev,
    .hs[data-at='end'] .hs__nav--next,
    .hs[data-at='none'] .hs__nav { opacity: 0 !important; pointer-events: none; }
  }
</style>

<script>
  (() => {
    const init = () => {
      for (const hs of document.querySelectorAll('[data-hscroll]')) {
        const track = hs.querySelector('[data-hs-track]');
        if (!track) continue;
        const prev = hs.querySelector('[data-hs-prev]');
        const next = hs.querySelector('[data-hs-next]');
        const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

        // 端まで行ったかを data-at に書く（CSS が霧とボタンを出し分ける）
        let queued = false;
        const update = () => {
          queued = false;
          const max = track.scrollWidth - track.clientWidth;
          if (max <= 8) { hs.dataset.at = 'none'; return; }
          const x = track.scrollLeft;
          hs.dataset.at = x <= 8 ? 'start' : x >= max - 8 ? 'end' : 'middle';
        };
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        };
        track.addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        // 画像の読み込みで幅が変わるけん、一段落してからもう一度測る
        update();
        setTimeout(update, 600);
        addEventListener('load', update, { once: true });

        const page = () => Math.max(160, Math.round(track.clientWidth * 0.82));
        if (prev) prev.addEventListener('click', () => track.scrollBy({ left: -page(), behavior: smooth }));
        if (next) next.addEventListener('click', () => track.scrollBy({ left: page(), behavior: smooth }));
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
  })();
</script>
