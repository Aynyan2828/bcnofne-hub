---
// フネのしるし（BCNOFNe のロゴ）の一画面。フッターのすぐ上に置く。
// ロゴは正本 BCNOFNe_Logo.jpeg の白抜きをそのまま使う（描き直さん）。指を当てた所が持ち上がる（public/brand/logo-lift.js）。
// トップを重くせんよう、画面に近づいた時だけ JS と画像を読む。JS が無い時はロゴの静止画。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="section section--mist shipmark" aria-labelledby="shipmark-title">
  <div class="container shipmark__inner">
    <div class="shipmark__scene" data-logo-lift data-base={base} role="img" aria-label="BCNOFNe のロゴ。情報の海に浮かぶ箱舟。指を当てた所が持ち上がる">
      <noscript><img class="shipmark__still" src={`${base}/brand/logo/mark-96.webp`} alt="" width="96" height="111" /></noscript>
    </div>
    <p class="shipmark__line" id="shipmark-title">情報の海に浮かぶ箱舟 — BCNOFNe</p>
  </div>
</section>

<script is:inline>
  (() => {
    const el = document.querySelector('[data-logo-lift]');
    if (!el) return;
    const go = () => {
      const s = document.createElement('script');
      s.src = `${el.dataset.base || ''}/brand/logo-lift.js`;
      document.head.appendChild(s);
    };
    if (!('IntersectionObserver' in window)) return go();
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); go(); } }, { rootMargin: '300px 0px' });
    io.observe(el);
  })();
</script>

<style>
  /* 紙だまり（section--mist）の上に置いて、夜空の背景でもロゴと一行が沈まんようにする */
  .shipmark { padding-top: clamp(2rem, 6vw, 3.4rem); padding-bottom: clamp(1.6rem, 5vw, 2.6rem); }
  .shipmark__inner { position: relative; z-index: 1; }
  .shipmark__inner { display: grid; justify-items: center; gap: 0.4rem; }
  .shipmark__scene {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 6 / 5;
    perspective: 1400px;
    overflow: hidden;
    touch-action: pan-y;
    cursor: crosshair;
  }
  .shipmark__still { display: block; margin: 20% auto 0; }
  .shipmark__line {
    margin: 0;
    font-family: 'Yusei Magic', var(--font-display, sans-serif);
    font-size: clamp(1rem, 3.6vw, 1.25rem);
    letter-spacing: 0.06em;
    color: var(--ink, #1f3a5f);
  }
  /* 持ち上がる面（logo-lift.js が作る） */
  .shipmark__scene :global(.ll-plane) {
    position: absolute; left: 50%; top: 52%;
    width: var(--w); height: var(--h);
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) scale(var(--s)) rotateX(38deg) rotateZ(-16deg);
  }
  .shipmark__scene :global(.ll-tile) {
    position: absolute; pointer-events: none; will-change: transform;
    background-image: var(--ll-img); background-size: var(--w) var(--h); background-repeat: no-repeat;
  }
  .shipmark__scene :global(.ll-dot), .shipmark__scene :global(.ll-shadow) { position: absolute; pointer-events: none; will-change: transform; }
  .shipmark__scene :global(.ll-shadow) { filter: brightness(0) blur(5px); opacity: 0; }
</style>
