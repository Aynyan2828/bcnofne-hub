---
/**
 * OceanField — 情報の海（Crypto Ocean）。ページ最背面の一枚の世界。
 *
 * ★みさとと（島根県美郷町）の解剖で分かった作り方に合わせとる:
 *   1. 1枚絵やなく **部品に割る** … 船体／帆／ランタンが別ファイル。
 *      別々に動かせるけん「波で船体が傾く → 帆がワンテンポ遅れて揺れる →
 *      ランタンだけ点滅する」が成立する。1枚絵やと全部が同じに動いて安っぽい。
 *   2. **横に流す帯** … 波と雲はタイルにして無限に流す。継ぎ目は
 *      「元絵＋左右反転」を交互に並べて消す（鏡張り）。GPT に継ぎ目の合う絵を
 *      描かせるのは無理やけん、こっちで作る。
 *   3. **固定canvasをカメラで動かす** … スクロール量がそのまま進んだ距離。
 *
 * 描くもの（奥から手前へ）:
 *   雲の帯 → 粒子(データの粒・星座線) → 遠い波 → 中の波 → 小舟 → 手前の波
 *   小舟を中の波と手前の波で挟むけん、舟が波間に沈んで見える。
 *
 * ★空は塗らん（透明のまま）。奥の水彩コラージュがそのまま空の役をする。
 *   一度 canvas に空を描いたら写真が全部隠れて失敗した。
 *
 * ── 実装の約束 ────────────────────────────────────────────────
 * ・canvas 2D 1枚。DOM は増やさん。
 * ・スクロールイベントは張らん（毎フレーム scrollY を読むだけ）。
 * ・30fps に間引く。タブが隠れたら描かん。
 * ・prefers-reduced-motion / save-data は1枚だけ描いて終わり（凪いだ海）。
 * ・最初の1枚は rAF を待たずに描く（裏タブでは rAF が来ん環境がある）。
 * ・画像が1枚も読めんでも粒子だけで成立する（絵に依存して真っ白にならん）。
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const PARTS = ['cloud_loop', 'wave_far', 'wave_mid', 'wave_near',
               'ship_hull', 'ship_sail', 'ship_lantern',
               'moon', 'cape_lighthouse', 'isle_a', 'isle_b', 'mist_loop',
               // 港の目印。港の id と同じ名前（port_<Section の id>）。
               // 港を増やす時は絵を1枚足して、ここに1行足すだけ。
               'port_apps', 'port_listen', 'port_music', 'port_sns', 'port_engine'];
const srcs = Object.fromEntries(PARTS.map((n) => [n, `${base}/world/${n}.webp`]));
---
<canvas class="ocean" data-ocean data-srcs={JSON.stringify(srcs)} aria-hidden="true"></canvas>

<style>
  .ocean {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1; /* コラージュと同じ層。DOM で後ろに置いとるけん上に出る */
    pointer-events: none;
    display: block;
  }
</style>

<script>
  (() => {
    const cv = document.querySelector('[data-ocean]');
    if (!cv) return;
    const ctx = cv.getContext('2d', { alpha: true });
    if (!ctx) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = !!(navigator.connection && navigator.connection.saveData);
    const still = reduce || saveData;

    /* ── 水彩パーツの読み込み ───────────────────────────────────
       読めた絵だけ使う。1枚も読めんでも粒子だけで成立する。 */
    const art = {};
    let srcs = {};
    try { srcs = JSON.parse(cv.dataset.srcs || '{}'); } catch (_) { srcs = {}; }

    /* ── 粒子（データの粒）───────────────────────────────────── */
    const HUES = ['#6aa9e0', '#8b7bd8', '#f4a6c4', '#ffffff'];
    const SPRITE = 64;
    const sprites = HUES.map((c) => {
      const s = document.createElement('canvas');
      s.width = s.height = SPRITE;
      const g = s.getContext('2d');
      const grd = g.createRadialGradient(SPRITE / 2, SPRITE / 2, 0, SPRITE / 2, SPRITE / 2, SPRITE / 2);
      grd.addColorStop(0, c);
      grd.addColorStop(0.35, c + '88');
      grd.addColorStop(1, c + '00');
      g.fillStyle = grd;
      g.fillRect(0, 0, SPRITE, SPRITE);
      return s;
    });

    let W = 0, H = 0, dpr = 1, dots = [];
    const build = () => {
      const n = Math.round(Math.min(W < 600 ? 70 : 140, Math.max(40, (W * H) / 1000 * 0.12)));
      dots = Array.from({ length: n }, (_, i) => ({
        x: Math.random(), y: Math.random(),
        z: 0.28 + Math.random() * 0.72,
        r: 0.8 + Math.random() * 2.2,
        c: i % 11 === 0 ? 3 : i % 3,
        ph: Math.random() * Math.PI * 2,
        wob: 0.3 + Math.random() * 0.9,
      }));
    };
    const fit = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
    };
    fit();
    let fitTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(fitTimer);
      fitTimer = setTimeout(() => { fit(); draw(0); }, 180);
    }, { passive: true });

    /* ── 帯を横に無限に流す（鏡張りで継ぎ目を消す）──────────────
       元絵とその左右反転を交互に並べると、どの継ぎ目でも端の絵柄が
       一致する。GPT に継ぎ目の合う絵を描かせるのは無理やけん、この手。 */
    const band = (im, y, h, offset, alpha) => {
      if (!im || !im.complete || !im.naturalWidth) return;
      const w = h * (im.naturalWidth / im.naturalHeight);
      if (w <= 0) return;
      const period = w * 2;
      let x = -(((offset % period) + period) % period);
      ctx.globalAlpha = alpha;
      let flip = 0;
      // 遠い帯は1枚が小さくなって枚数が増える。万一に備えて上限を置く
      const MAX_TILES = 40;
      while (x < W && flip < MAX_TILES) {
        if (flip % 2 === 0) {
          ctx.drawImage(im, x, y, w, h);
        } else {
          ctx.save();
          ctx.translate(x + w, y);
          ctx.scale(-1, 1);
          ctx.drawImage(im, 0, 0, w, h);
          ctx.restore();
        }
        x += w;
        flip++;
      }
      ctx.globalAlpha = 1;
    };

    /* ── 部品を1枚置く ─────────────────────────────────────── */
    const part = (im, cx, cy, h, rot, alpha) => {
      if (!im || !im.complete || !im.naturalWidth) return;
      const w = h * (im.naturalWidth / im.naturalHeight);
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.translate(cx, cy);
      if (rot) ctx.rotate(rot);
      ctx.drawImage(im, -w / 2, -h / 2, w, h);
      ctx.restore();
      ctx.globalAlpha = 1;
    };

    /* ── 小舟（部品を別々に動かす）────────────────────────────
       船体が波で傾き、帆はワンテンポ遅れて大きく揺れ、ランタンだけ
       別のリズムで点滅する。部品に割った甲斐がここ。 */
    const drawBoat = (t, by, hullH) => {
      const bx = W * 0.24;
      const roll = Math.sin(t * 0.9) * 0.05;
      const lag = Math.sin(t * 0.9 - 0.55) * 0.075;
      const bob = Math.sin(t * 1.3) * hullH * 0.18;
      const y = by + bob;
      part(art.ship_sail, bx + hullH * 0.05, y - hullH * 1.15, hullH * 2.2, lag, 0.9);
      part(art.ship_hull, bx, y, hullH, roll, 0.95);
      const flick = 0.72 + 0.28 * Math.sin(t * 3.1) * Math.sin(t * 1.7);
      part(art.ship_lantern, bx + hullH * 0.9, y - hullH * 0.55, hullH * 1.1, roll, flick);
    };

    /* ── 1フレーム ──────────────────────────────────────────── */
    /* ── 港に入ると船は速度を落とす ─────────────────────────────
       港の入口(HarborGate)に近づくほど calm が 1 に寄って、
       波の行進が緩み・波が落ち着き・視点が少し上がり・靄が晴れる。
       外洋（港と港のあいだ）では calm=0 で、いつもの速さで進む。

       ★時間で進む位相は **必ず足し込みで** 持つ。`t * 速さ` の形で
       速さを変えると、t が大きいほど位置が飛ぶ（60秒後に速さを1割変えると
       波が百数十px ワープする）。rate を変えたいなら位相を積分すること。 */
    let marchPhase = 0;   // 奥行き方向の行進（0〜1 で1周）
    let flowPhase = 0;    // 横に流れるぶん
    let lastT = 0;
    let gates = [];
    let gateTick = 0;
    const measureGates = () => {
      gates = Array.from(document.querySelectorAll('[data-gate]'), (g, idx) => {
        const r = g.getBoundingClientRect();
        return { y: scrollY + r.top + r.height / 2, port: g.dataset.port || '', idx };
      });
    };
    addEventListener('resize', measureGates);

    const draw = (t) => {
      const sc = scrollY;
      ctx.clearRect(0, 0, W, H);

      /* ── カメラ ── みさととが「空から町へ降りて絵の中に入る」のと同じで、
         こっちは **空の高みから海面へ降りていく**。
         ページ全体の進み(0→1)で視点の高さが下がる:
           高い … 水平線が低く見えて、海が広く、波は小さく遠い（俯瞰）
           低い … 水平線が上がって、波が大きく迫る（海面すれすれ）
         横に流すだけの視差やなく、**視点そのものが動く**けん
         「世界の中に入っていく」感じが出る。 */
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const journey = Math.min(1, Math.max(0, sc / maxScroll));
      const descend = Math.pow(journey, 0.8);          // 前半でぐっと降りる

      // 経った時間（秒）。画像の読み込みで draw(0) が飛んでくるけん上限を付ける
      const dt = Math.min(0.1, Math.max(0, t - lastT));
      lastT = t;

      // 港との距離 → calm(0=外洋 / 1=港のまん中)
      if (gateTick-- <= 0) { measureGates(); gateTick = 30; }  // 1秒に1回だけ測る
      const eye = sc + H / 2;
      let near = 0;
      for (const g of gates) {
        const d = Math.abs(eye - g.y) / (H * 0.75);
        if (d < 1) near = Math.max(near, 1 - d);
      }
      const calm = near * near * (3 - 2 * near);   // 角を取る(smoothstep)

      // 水平線: 俯瞰(0.34) → 海面すれすれ(0.56)。港では少しだけ視点が上がる
      const horizon = H * (0.34 + descend * 0.22) - H * 0.018 * calm;
      // 近づくほど波も大きく見える（視点が低いと手前の波が立ちはだかる）
      const zoom = (0.72 + descend * 0.6) * (1 - calm * 0.1);

      // 0. 遠景の目印。水平線の向こうに置いて、ゆっくり左へ流す。
      //    ここに何か在るだけで「どこへ向かっとるか」が分かる。
      //    月 → 島影 → 灯台のある岬、の順で近づいてくる。
      part(art.moon, W * (0.78 - journey * 0.1), H * (0.12 + descend * 0.06),
           H * 0.11 * (0.9 + descend * 0.2), 0, 0.8);
      const farDrift = (u) => ((u - sc * 0.00018) % 1.6 + 1.6) % 1.6 * W - W * 0.3;
      part(art.isle_a, farDrift(0.55), horizon - H * 0.012, H * 0.05 * zoom, 0, 0.55);
      part(art.isle_b, farDrift(1.15), horizon - H * 0.008, H * 0.035 * zoom, 0, 0.5);
      part(art.cape_lighthouse, farDrift(0.05), horizon - H * 0.018, H * 0.055 * zoom, 0, 0.6);

      // 1. 雲の帯（いちばん奥・いちばんゆっくり）
      // 雲も少しだけ手前に流す（上へ抜けていく＝自分が進んどる）
      const cz = ((sc * 0.00022 + t * 0.012) % 1 + 1) % 1;
      band(art.cloud_loop, horizon - H * (0.30 + cz * 0.26), H * (0.22 + cz * 0.14),
           sc * 0.06 + t * 3, 0.5 * (1 - cz) + 0.12);

      // 2. 粒子（データの粒）＋星座線
      const pts = [];
      ctx.globalCompositeOperation = 'lighter';
      for (const d of dots) {
        const flow = (sc * 0.10 + t * 7) * d.z;
        const span = H * 1.25;
        const y = ((((d.y * H - flow) % span) + span) % span) - (span - H) / 2;
        const x = d.x * W + Math.sin(t * d.wob * 0.5 + d.ph) * 14 * d.z;
        ctx.globalAlpha = 0.9 * (0.55 + 0.45 * Math.sin(t * 1.1 + d.ph)) * (0.35 + d.z * 0.65);
        const size = d.r * (0.6 + d.z * 1.5) * 7;
        ctx.drawImage(sprites[d.c], x - size / 2, y - size / 2, size, size);
        if (d.z > 0.72 && pts.length < 30) pts.push({ x, y });
      }
      ctx.globalCompositeOperation = 'source-over';
      ctx.lineWidth = 0.7;
      ctx.strokeStyle = '#cfe0ff';
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const dist = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
          if (dist > 130) continue;
          ctx.globalAlpha = 0.22 * (1 - dist / 130);
          ctx.beginPath();
          ctx.moveTo(pts[i].x, pts[i].y);
          ctx.lineTo(pts[j].x, pts[j].y);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;

      /* 3. 波 ── ★「前に進んどる」の作り方 ─────────────────────
         横に流すと「景色が横に動く」だけで、進んどるように見えん。
         奥行きは **水平線から手前へ迫らせる** ことで出す:
           z = 1 … 水平線のすぐ向こう（遠い）
           z = 0 … 画面の下（目の前）
         スクロールすると z が減る＝波が自分に向かってくる。
         近いほど **下に来て・大きくなって・速く流れる**（遠近法）。
         画面の下を通り過ぎた波は、水平線の向こうへ戻して使い回す。 */
      /* 2.5 港の目印 ── みさとと式の「決まった場所に、その土地の物が在る」。
         港の入口に着く2画面ほど手前で水平線の向こうに現れて、近づくほど
         大きく手前に寄り、通り過ぎると後ろへ抜けていく。
         港ごとに左右を振る（右に見えた次は左）＝すれ違う感じが出る。
         深さ(kd)を波と同じ物差しで持って、**その深さの波より奥**に描く
         （手前の波が目印の足元を隠す＝海に浮いて見える）。 */
      const marks = [];
      for (const g of gates) {
        const im = art['port_' + g.port];
        if (!im) continue;
        const rel = (eye - g.y) / (H * 2.4);      // -1=まだ先 / 0=港 / + =通過
        if (rel < -1 || rel > 0.75) continue;
        const k = Math.min(1, Math.max(0, (rel + 1) / 1.35));
        const kd = 0.12 + k * 0.6;                // 波の物差しでの深さ
        const y = horizon + (H - horizon) * Math.pow(kd, 2.3);
        const h = H * (0.05 + 0.24 * Math.pow(k, 1.6)) * zoom;
        const side = g.idx % 2 === 0 ? 1 : -1;
        const x = W * (0.5 + side * (0.2 + k * 0.2));
        const fadeIn = Math.min(1, (rel + 1) * 3);
        const fadeOut = rel > 0.35 ? Math.max(0, 1 - (rel - 0.35) / 0.4) : 1;
        const a = fadeIn * fadeOut * 0.95;
        if (a > 0.01) marks.push({ im, x, y, h, a, kd, drawn: false });
      }
      const drawMark = (m) => {
        // 画像のまん中が cy。足元(下端)が水面より少し沈むように置く
        part(m.im, m.x, m.y - m.h * 0.42, m.h, 0, m.a);
        m.drawn = true;
      };

      const ROWS = 9;
      const speed = 1 - calm * 0.62;            // 港では6割ほど減速
      marchPhase += dt * 0.022 * speed;
      flowPhase += dt * speed;
      const march = sc * 0.00042 + marchPhase;  // 進む速さ
      const waveImgs = [art.wave_far, art.wave_mid, art.wave_near];
      let boatDrawn = false;
      /* ★奥から手前の順に並べ直してから描く。i の順のままやと、行が1周して
         戻るところで順番が「近→最も近→（折り返し）→遠」になって、
         **水平線際の遠い波が、手前にあるはずの港の目印や小舟の上に塗られる**
         （目印が水平線に貼り付いたまま沈んで消えた原因）。 */
      const rows = [];
      for (let i = 0; i < ROWS; i++) {
        const z = ((i / ROWS - march) % 1 + 1) % 1;
        rows.push({ i, k: 1 - z });              // 0=遠 → 1=近
      }
      rows.sort((a, b) => a.k - b.k);
      for (const { i, k } of rows) {
        const ease = Math.pow(k, 2.3);           // 遠くほど詰まって見える
        const y = horizon + (H - horizon) * ease;
        const h = H * (0.028 + 0.30 * Math.pow(k, 1.9)) * zoom;
        // 水平線際でふわっと湧いて、手前で少し薄れる（唐突に出入りさせん）
        const a = Math.min(1, k * 7) * (1 - Math.pow(k, 6)) * 0.95;
        if (a <= 0.01) continue;

        // 港の目印も同じ。自分より手前の波が来る前に描く
        for (const m of marks) if (!m.drawn && k > m.kd) drawMark(m);

        // 小舟は「ある深さ」に居る。その深さの波を跨ぐ手前で描く＝波間に沈む
        if (!boatDrawn && k > 0.42) {
          drawBoat(t, horizon + (H - horizon) * Math.pow(0.42, 2.3), H * 0.052 * zoom);
          boatDrawn = true;
        }
        // 近いほど横にも速く流れる（真正面に進んどるんやなく、少し斜めに渡る）
        band(waveImgs[i % 3], y, h, sc * (0.05 + k * 0.5) + flowPhase * (3 + k * 26), a);
      }
      for (const m of marks) if (!m.drawn) drawMark(m);
      if (!boatDrawn) drawBoat(t, horizon + (H - horizon) * Math.pow(0.42, 2.3), H * 0.052 * zoom);

      // 5. 霧。航海が深まるほど濃くなる（深夜の海）
      // ★港では靄が**晴れる**。前は逆に濃くしとって、いちばん見せたい
      //   港の目印を靄が上から塗りつぶしとった（港のまん中で目印が消えた）。
      //   港に入ったら視界が開ける方が、見た目も理屈も合う。
      const fog = Math.min(0.5, Math.max(0, (journey - 0.35) * 0.9)) * (1 - calm * 0.75);
      if (fog > 0.01) {
        band(art.mist_loop, horizon - H * 0.04, H * 0.22, sc * 0.12 + t * 6, fog);
      }
    };

    /* ── 背景コラージュの視差 ＋ 照り返しの帯（同じループで動かす）──
       ループを2本持たんために、ここで両方まとめて動かす。 */
    const layers = Array.from(document.querySelectorAll('[data-par]'))
      .map((el) => ({ el, d: parseFloat(el.dataset.par) || 0 }));
    // 照り返しの帯は**ここで差し込む**。別コンポーネントで差し込むと、
    // 集める時にまだ存在せん、という順番の事故が起きる（実際それで動かんかった）。
    for (const sec of document.querySelectorAll('.section')) {
      if (sec.querySelector(':scope > .wash')) continue;
      const w = document.createElement('span');
      w.className = 'wash';
      w.setAttribute('aria-hidden', 'true');
      sec.appendChild(w);
    }
    const washes = Array.from(document.querySelectorAll('.section > .wash'))
      .map((el) => ({ el, sec: el.parentElement }));
    function parallax() {
      const y = scrollY;
      for (const l of layers) {
        l.el.style.transform = `translate3d(0, ${(-y * l.d).toFixed(1)}px, 0)`;
      }
      // 照り返し: そのセクションが画面を通り過ぎる間に -1 → 1 へ動く。
      // 画面に入っとるセクションだけ触る（全部毎フレーム触ると無駄）。
      for (const w of washes) {
        const r = w.sec.getBoundingClientRect();
        if (r.bottom < -40 || r.top > innerHeight + 40) continue;
        const pos = (innerHeight - r.top) / (innerHeight + r.height); // 0→1
        w.el.style.setProperty('--wash', (pos * 2 - 1).toFixed(3));
      }
    }

    // 絵は後から届く。読めたら描き直す（静止モードでもこれで反映される）
    for (const [name, url] of Object.entries(srcs)) {
      const im = new Image();
      im.decoding = 'async';
      im.onload = () => { art[name] = im; draw(0); };
      im.src = url;
    }

    // 検証用の口。裏タブ・描画エンジンでは rAF が来んけん、スクロールを変えても
    // 絵が描き直されん＝目でも測定でも確かめられん。手で1コマ描けるようにしとく。
    // （関数の参照を1つ置くだけ。挙動には影響せん）
    window.__oceanDraw = (t) => { draw(t || 0); parallax(); };

    draw(0);
    parallax();
    if (still) return;

    let last = 0;
    const FRAME = 1000 / 30;
    let raf = 0;
    const loop = (now) => {
      raf = requestAnimationFrame(loop);
      if (now - last < FRAME) return;
      last = now;
      if (document.hidden) return;
      draw(now / 1000);
      parallax();
    };
    raf = requestAnimationFrame(loop);
    addEventListener('pagehide', () => cancelAnimationFrame(raf), { once: true });
  })();
</script>
