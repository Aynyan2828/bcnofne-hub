---
interface Props {
  /** en のときは英語の一行＋日本語版への切替。既定 ja */
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = 2026;
const links = [
  { label: 'YouTube', url: 'https://www.youtube.com/@AYNSleepRadio' },
  { label: 'X', url: 'https://x.com/Aynyann' },
  { label: 'Instagram', url: 'https://www.instagram.com/aynyan28' },
  { label: 'TikTok', url: 'https://www.tiktok.com/@aynyan2828' },
  { label: 'Bluesky', url: 'https://bsky.app/profile/aynyan.bsky.social' },
  { label: 'LINE', url: 'https://lin.ee/V2sme7z' },
  { label: 'SUZURI', url: 'https://suzuri.jp/BCNOFNe' },
];
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{lang === 'en' ? 'BCNOFNe' : 'BCNOFNe〜ボクのフネ〜'}</p>
      <p class="footer__tag">{lang === 'en'
        ? 'A one-person studio, sailing with an AI engineer named AYN.'
        : '機関士AI AYN と、情報の海を航海するばい。'}</p>
      {/* 言語の切替（Prompt259）。さりげなく、ブランド名の下に1本だけ */}
      {lang === 'en'
        ? <a class="footer__lang" href={`${base}/`} hreflang="ja" lang="ja">日本語サイトへ</a>
        : <a class="footer__lang" href={`${base}/en/`} hreflang="en" lang="en">English</a>}
    </div>
    <nav class="footer__links" aria-label="外部リンク">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
      ))}
    </nav>
  </div>
  <div class="footer__bar">
    <div class="container">
      {/* 運営者と連絡先（Claude for Startups などの審査でサイトとメールの一致を見せる・2026-10-07） */}
      <p class="footer__operator">{lang === 'en'
        ? <>Operated by BCNOFNe, an independent one-person studio in Japan. Contact: <a href="mailto:support@bcnofne.com">support@bcnofne.com</a></>
        : <>運営：BCNOFNe（個人の工房）　お問い合わせ：<a href="mailto:support@bcnofne.com">support@bcnofne.com</a></>}</p>
      <small>© {year} BCNOFNe / AYN. All rights reserved.</small>
    </div>
  </div>
</footer>

<style>
  .footer {
    /* ★Hero と同じグラデ(--grad-hero)は下の端が明るい水色(#9fb6e6)で、一番下の
       著作権表示（白）が 2.9〜3.5 しか出とらんかった。フッターは下まで夜の紺のまま */
    background: radial-gradient(120% 120% at 50% 0%, #2a3566 0%, #3a4a86 45%, #46569a 100%);
    color: #fff;
    padding-top: clamp(2.4rem, 6vw, 3.4rem);
    margin-top: 2rem;
  }
  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.8rem;
  }
  .footer__name { font-family: var(--font-display); font-size: 1.15rem; margin: 0; }
  .footer__tag { margin: 0.4rem 0 0; opacity: 0.85; font-size: 0.9rem; }
  .footer__lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;   /* 押せる所は 44px（ui_audit） */
    margin-top: 0.7rem;
    padding: 0.28em 0.9em;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
  }
  .footer__lang:hover { background: rgba(255, 255, 255, 0.12); text-decoration: none; }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    align-content: flex-start;
  }
  .footer__links a { color: rgba(255,255,255,0.9); font-size: 0.92rem; }
  .footer__links a:hover { color: #fff; }
  .footer__bar {
    border-top: 1px solid rgba(255,255,255,0.16);
    padding-block: 1rem;
  }
  .footer__bar small { opacity: 0.92; font-size: 0.82rem; }
  .footer__operator { margin: 0 0 0.4rem; font-size: 0.82rem; opacity: 0.92; overflow-wrap: anywhere; }
  .footer__operator a { color: #fff; text-decoration: underline; }   /* 0.75 やと 2.9 しか出とらんかった */
</style>
