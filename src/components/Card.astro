---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  url: string;
  cta?: string;
  handle?: string;
  badge?: string; // 価格やサービス名など
  icon?: ImageMetadata;
  image?: ImageMetadata; // カード上部の横長サムネイル
  /** 気分タグ（MoodPicker の絞り込み用）。空配列＝どの気分でも出る常設カード。 */
  moods?: string[];
}
const { title, summary, url, cta = '開く', handle, badge, icon, image, moods } = Astro.props;
const external = /^https?:\/\//.test(url);
// サムネイルの縦横比: 正方形アートは切らずにそのまま、横長は16:9まで
const thumbRatio = image
  ? Math.max(1, Math.min(16 / 9, image.width / image.height))
  : null;
---
<article class="card" data-moods={moods ? moods.join(' ') : undefined}>
  <a class="card__link" href={url} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
    {image && (
      <div class="card__thumb" style={`aspect-ratio: ${thumbRatio};`}>
        <Image
          src={image}
          alt=""
          widths={[320, 480, 640]}
          sizes="(max-width: 560px) 90vw, 320px"
          loading="lazy"
        />
      </div>
    )}
    <div class="card__inner">
      {icon && (
        <div class="card__icon">
          <Image src={icon} alt={`${title} のアイコン`} width={96} height={96} />
        </div>
      )}
      <div class="card__body">
        <div class="card__meta">
          <h3 class="card__title" data-type data-type-delay="120" data-type-step="45">{title}</h3>
          {badge && <span class="card__badge">{badge}</span>}
        </div>
        {handle && <p class="card__handle" data-type data-type-delay="380" data-type-step="30">{handle}</p>}
        {/* 説明は長いけん速め。カードが何枚並んでも 1.5 秒ほどで書き終わる */}
        <p class="card__summary" data-type data-type-delay="480" data-type-step="14">{summary}</p>
        <span class="card__cta" data-type data-type-delay="900" data-type-step="40">
          {cta}
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--c-card);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    height: 100%;
    overflow: hidden;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--c-blue);
  }
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .card__thumb {
    overflow: hidden;
    line-height: 0;
    background: var(--c-mist);
  }
  .card__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .card:hover .card__thumb :global(img) { transform: scale(1.04); }
  .card__inner {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.2rem;
    flex: 1;
  }
  .card__icon img {
    width: 64px; height: 64px;
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
  }
  .card__body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .card__meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .card__title { font-size: 1.08rem; }
  .card__badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-blue-deep);
    background: var(--c-mist);
    padding: 0.15em 0.6em;
    border-radius: 999px;
    white-space: nowrap;
  }
  .card__handle {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: var(--c-ink-soft);
    font-family: var(--font-display);
  }
  .card__summary {
    margin: 0.5rem 0 0.9rem;
    font-size: 0.92rem;
    color: var(--c-ink-soft);
    line-height: 1.65;
    flex: 1;
  }
  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-blue-deep);
  }
  .card:hover .card__cta svg { transform: translateX(3px); }
  .card__cta svg { transition: transform 0.18s ease; }
</style>
