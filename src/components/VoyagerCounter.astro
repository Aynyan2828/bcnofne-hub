---
// Crypto Ocean 航海者カウンター＋国別あいさつ（bcnofne-edge の /counter と /greeting）。
const EDGE = 'https://bcnofne-edge.aynbcnofne.workers.dev';
---
<aside class="voyager" data-voyager data-endpoint={EDGE} aria-live="polite">
  <span class="voyager__anchor" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="5" r="2.2"/>
      <line x1="12" y1="7.2" x2="12" y2="21"/>
      <line x1="7.5" y1="11" x2="16.5" y2="11"/>
      <path d="M4 14a8 8 0 0 0 16 0"/>
    </svg>
  </span>
  <p class="voyager__text">
    <span data-pre data-type data-type-step="42">ようこそ、Crypto Ocean へ。きみは </span>
    <span class="voyager__no" data-count>—</span>
    <span data-post data-type data-type-delay="1100" data-type-step="42"> 人目の航海者ばい。</span>
  </p>
  <p class="voyager__gloss">
    <b>Crypto Ocean</b> ＝ AI・アプリ・音楽・創作が流れる情報の海。BCNOFNe ではこの海のことばい。
  </p>
  <!-- ようこその締め。このあと外洋を一区間渡ってから最初の港に着く -->
  <p class="voyager__bon" data-bon data-type data-type-delay="1900" data-type-step="85">それでは、航海をお楽しみください。</p>
</aside>

<script>
  const el = document.querySelector('[data-voyager]');
  if (el) {
    const numEl = el.querySelector('[data-count]');
    const preEl = el.querySelector('[data-pre]');
    const postEl = el.querySelector('[data-post]');
    const EP = el.getAttribute('data-endpoint');
    const KEY = 'bcnofne_voyager_no';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const countUp = (n) => {
      const finalTxt = n.toLocaleString('en-US');
      // 保険: アニメが動かん環境(非可視タブ等)でも最終値は必ず出す
      const guard = setTimeout(() => { numEl.textContent = finalTxt; }, 1100);
      if (reduce) { clearTimeout(guard); numEl.textContent = finalTxt; return; }
      const dur = 900, t0 = performance.now(), from = Math.max(0, n - 30);
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        const v = Math.round(from + (n - from) * (1 - Math.pow(1 - p, 3)));
        numEl.textContent = v.toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
        else clearTimeout(guard);
      };
      requestAnimationFrame(tick);
    };

    // 国別あいさつ（/greeting の lang で日本語/英語を出し分け）
    const applyLang = async () => {
      try {
        const g = await fetch(EP + '/greeting').then((r) => r.json());
        if (g && g.lang === 'en') {
          preEl.textContent = 'Welcome aboard the Crypto Ocean. You are voyager No. ';
          postEl.textContent = '.';
          const bon = el.querySelector('[data-bon]');
          if (bon) bon.textContent = 'Now, enjoy the voyage.';
        }
      } catch (_) { /* 失敗時は既定の日本語のまま */ }
    };

    const fallback = () => {
      const t = el.querySelector('.voyager__text');
      if (t) t.textContent = 'ようこそ、Crypto Ocean へ。';
    };

    (async () => {
      applyLang();
      try {
        const stored = localStorage.getItem(KEY);
        if (stored && /^\d+$/.test(stored)) {
          countUp(parseInt(stored, 10));
          return;
        }
        const data = await fetch(EP + '/counter').then((r) => r.json());
        if (!data || typeof data.ordinal !== 'number') throw new Error('bad');
        localStorage.setItem(KEY, String(data.ordinal));
        el.classList.add('voyager--welcome');
        countUp(data.ordinal);
      } catch (_) {
        fallback();
      }
    })();
  }
</script>

<style>
  .voyager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    padding: 2.2rem 1rem 2rem;
    min-height: 3rem;
    color: var(--c-ink-soft);
    font-size: 0.92rem;
    /* ★下に外洋を一区間足したら、波の上に文字が乗って読めんくなった。
       港と同じ「紙だまり」を敷く（上下の端はぼかして海に溶かす）。 */
    background: linear-gradient(
      180deg,
      rgba(243, 246, 255, 0) 0%,
      rgba(243, 246, 255, 0.9) 18%,
      rgba(243, 246, 255, 0.94) 50%,
      rgba(243, 246, 255, 0.9) 82%,
      rgba(243, 246, 255, 0) 100%
    );
    text-align: center;
  }
  .voyager__anchor { display: inline-flex; color: var(--c-blue-deep); flex-shrink: 0; }
  .voyager__text { margin: 0; }
  /* Crypto Ocean の注記: 暗号資産専門サイトと間違われんための一行（控えめに） */
  .voyager__gloss {
    flex-basis: 100%;
    margin: 0.15rem 0 0;
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--c-ink-soft);
    opacity: 0.9;
  }
  .voyager__gloss b {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--c-blue-deep);
  }
  /* 締めの一言。見出しと同じ手書きの書体で、少し大きめに */
  .voyager__bon {
    flex-basis: 100%;
    margin: 0.9rem 0 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 4.2vw, 1.35rem);
    letter-spacing: 0.08em;
    color: var(--c-blue-deep);
  }
  .voyager__no {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15em;
    color: var(--c-blue-deep);
    font-variant-numeric: tabular-nums;
    padding: 0 0.15em;
  }
  .voyager--welcome .voyager__no { color: var(--c-purple); animation: voyagerGlow 2.4s ease-out; }
  @keyframes voyagerGlow {
    0% { text-shadow: 0 0 0 rgba(139, 123, 216, 0); }
    30% { text-shadow: 0 0 14px rgba(139, 123, 216, 0.7); }
    100% { text-shadow: 0 0 0 rgba(139, 123, 216, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .voyager--welcome .voyager__no { animation: none; }
  }
</style>
