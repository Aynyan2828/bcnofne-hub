---
// Crypto Ocean 航海者カウンター。
// エンドポイントは Cloudflare Worker（デプロイ後にURLを差し替える）。
const COUNTER_ENDPOINT = 'https://bcnofne-voyager.aynbcnofne.workers.dev';
---
<aside class="voyager" data-voyager data-endpoint={COUNTER_ENDPOINT} aria-live="polite">
  <span class="voyager__anchor" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="5" r="2.2"/>
      <line x1="12" y1="7.2" x2="12" y2="21"/>
      <line x1="7.5" y1="11" x2="16.5" y2="11"/>
      <path d="M4 14a8 8 0 0 0 16 0"/>
    </svg>
  </span>
  <p class="voyager__text">
    ようこそ、Crypto Ocean へ。きみは
    <span class="voyager__no" data-count>—</span>
    人目の航海者ばい。
  </p>
</aside>

<script>
  const el = document.querySelector('[data-voyager]');
  if (el) {
    const numEl = el.querySelector('[data-count]');
    const EP = el.getAttribute('data-endpoint');
    const KEY = 'bcnofne_voyager_no';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const countUp = (n) => {
      if (reduce) { numEl.textContent = n.toLocaleString('ja-JP'); return; }
      const dur = 900, t0 = performance.now(), from = Math.max(0, n - 30);
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        const v = Math.round(from + (n - from) * (1 - Math.pow(1 - p, 3)));
        numEl.textContent = v.toLocaleString('ja-JP');
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const fallback = () => {
      // 取得失敗時: 番号入りの文をやめ、同じ高さのまま挨拶だけ残す
      const t = el.querySelector('.voyager__text');
      if (t) t.textContent = 'ようこそ、Crypto Ocean へ。';
    };

    (async () => {
      try {
        const stored = localStorage.getItem(KEY);
        if (stored && /^\d+$/.test(stored)) {
          countUp(parseInt(stored, 10));
          return;
        }
        const res = await fetch(EP + '/hit', { method: 'POST' });
        const data = await res.json();
        if (!data || typeof data.no !== 'number') throw new Error('bad');
        localStorage.setItem(KEY, String(data.no));
        el.classList.add('voyager--welcome');
        countUp(data.no);
      } catch (_) {
        fallback();
      }
    })();
  }
</script>

<style>
  .voyager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.7rem 1rem;
    min-height: 3rem; /* CLS防止: 高さを固定 */
    color: var(--c-ink-soft);
    font-size: 0.92rem;
    background: linear-gradient(180deg, rgba(234, 241, 251, 0.5), rgba(251, 252, 255, 0.2));
    text-align: center;
  }
  .voyager__anchor {
    display: inline-flex;
    color: var(--c-blue-deep);
    flex-shrink: 0;
  }
  .voyager__no {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15em;
    color: var(--c-blue-deep);
    font-variant-numeric: tabular-nums;
    padding: 0 0.15em;
  }
  /* 初訪問のときだけ番号を光らせる */
  .voyager--welcome .voyager__no {
    color: var(--c-purple);
    animation: voyagerGlow 2.4s ease-out;
  }
  @keyframes voyagerGlow {
    0% { text-shadow: 0 0 0 rgba(139, 123, 216, 0); }
    30% { text-shadow: 0 0 14px rgba(139, 123, 216, 0.7); }
    100% { text-shadow: 0 0 0 rgba(139, 123, 216, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .voyager--welcome .voyager__no { animation: none; }
  }
</style>
