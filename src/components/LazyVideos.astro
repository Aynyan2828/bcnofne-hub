---
/**
 * 動画は「押した時だけ」読み込む（1ページに1つ置くだけの裏方コンポーネント）
 *
 * `<video data-lazyvideo data-src="/media/xxx.mp4" poster="..." preload="none">` を、
 *   - 表紙の絵（poster）だけ出して、スマホ標準の再生ボタンを付ける
 *   - 再生ボタンを押した時に初めて動画を読み込む（preload="none"）
 *   - 画面の外に出たら一時停止
 * にする。
 *
 * ★前は「画面の1つ手前で読み込み開始→見えとる間は自動再生」やった。スクロールしきると
 *   動画 4 本で約 17.5MB を勝手に使っとった（スマホの通信量）。UI UX Pro Max §3
 *   （重いメディアは必要になるまで読まん）に合わせて、押した人だけが読み込む形にした。
 */
---
<script>
  (() => {
    const vids = Array.from(document.querySelectorAll('video[data-lazyvideo]'));
    if (!vids.length) return;

    for (const v of vids) {
      v.setAttribute('controls', '');
      v.preload = 'none';                 // 再生を押すまで 1 バイトも取りに行かん
      if (v.dataset.src && !v.getAttribute('src')) v.src = v.dataset.src;
    }

    if (!('IntersectionObserver' in window)) return;
    // 見えんところで鳴り続けんよう、画面の外に出たら止める
    const io = new IntersectionObserver(
      (es) => {
        for (const e of es) {
          if (!e.isIntersecting && !e.target.paused) e.target.pause();
        }
      },
      { threshold: 0.1 }
    );
    for (const v of vids) io.observe(v);
  })();
</script>
