---
/**
 * TypeText — 見出し用の薄い包み。中身の動きは TextFx.astro が全部持つ。
 *
 * 前は文字をここ（ビルド時）で1文字ずつに割っとったけど、本文や
 * <strong> 入りの文にも同じ演出をかけたくなって、割るのを TextFx（実行時）に
 * 一本化した。ここは「港の色で出す見出し」という印を付けるだけ。
 *
 * mode:
 *   'type'     … 1文字ずつ色を変えながら湧く（既定）
 *   'scramble' … JIZURA 式。カタカナや記号に化けながら確定していく（港の名前用）
 */
interface Props {
  text: string;
  as?: string;
  class?: string;
  mode?: 'type' | 'scramble';
}
const { text, as: Tag = 'span', class: cls, mode = 'type' } = Astro.props;
---
<Tag class:list={['type', cls]} data-type={mode === 'scramble' ? 'scramble' : ''}>{text}</Tag>

<style is:global>
  /* 落ち着いたあとの文字色。港ごとに変わる（global.css の [data-tone]） */
  .type { color: var(--sw-ink, var(--c-ink)); }
</style>
