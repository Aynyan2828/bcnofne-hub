---
import { Image } from 'astro:assets';
import keyVisual from '../assets/ayn-keyvisual.png';
// コラージュはページ全体共通の CollageBackdrop.astro に統一。
// Hero は半透明の紺グラデ（スクリム兼用）で背後の写真をうっすら見せる。
// アートは「動く AYN」(public/ayn-rig: ayn-jarvis の build_rig.py が出す 640px WebP 版)。
// JS が無い / 動きを減らす設定 / 読み込み失敗 のときは従来のキービジュアル画像に戻る。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// ビルドごとに版数を付けて、古い rig.json/rig.js のキャッシュと新しいパーツ画像が混ざらんようにする
// (混ざると temple_L/R みたいな新レイヤーが描かれず、髪が欠けて見える)
const rigVer = Date.now().toString(36);
const rigUrl = `${base}/ayn-rig/rig.json?v=${rigVer}`;
const rigJs = `${base}/ayn-rig/rig.js?v=${rigVer}`;

// 積荷（この船が何を作っとるか）。各港へのアンカーを兼ねる。
// 新しいジャンルを始めたらここに1行足す。
const CARGO = [
  { en: 'Apps', ja: 'iPhoneアプリ', href: '#apps' },
  { en: 'Radio', ja: '睡眠・作業BGM', href: '#listen' },
  { en: 'Music', ja: '配信EP', href: '#music' },
  { en: 'Art', ja: '水彩の情景', href: '#about' },
  { en: 'AI', ja: '機関士AI AYN', href: '#about' },
];
---
<header class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">BCNOFNe〜ボクのフネ〜</p>
      <h1 class="hero__title">
        情報の海を、<br />ぼくと一緒に航海しようや。
      </h1>
      <p class="hero__lead">
        機関士AI の <strong>AYN（あゆにゃん）</strong> ばい。
        アプリも、眠れん夜の音楽も、ラジオも、ぜんぶこの一枚にまとめとうけん。
        気になるところから、ゆっくり見ていってほしか。
      </p>
      <div class="hero__cta">
        <a class="btn" href="#apps">アプリを見る</a>
        <a class="btn btn--ghost" href={`${base}/angleon/`}>新作 Angleon（制作中）</a>
      </div>
      <!-- 積荷マニフェスト: 初めて来た人が3秒で「何を作っとる場所か」分かる行 -->
      <p class="hero__manifest-q">この船が積んどるもの</p>
      <ul class="hero__manifest">
        {CARGO.map((c) => (
          <li>
            <a href={c.href}>
              <b>{c.en}</b>
              <span>{c.ja}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero__art">
      <div class="hero__rig" id="ayn-rig" data-rig={rigUrl} data-js={rigJs} title="タップすると喋るばい">
        <canvas class="hero__canvas" aria-hidden="true"></canvas>
        <span class="hero__bubble" aria-live="polite"></span>
      </div>
      <Image
        src={keyVisual}
        alt="水彩で描かれた機関士AI AYN。青紫の髪に赤メガネ、夜空と流星の航海シーン。"
        widths={[320, 480, 640]}
        sizes="(max-width: 720px) 70vw, 420px"
        loading="eager"
        class="hero__img"
      />
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 6rem);
    /* 半透明の紺グラデ。背後のコラージュ写真と、その上を流れる
       情報の海（OceanField の粒子）がうっすら透ける濃さにしとる。 */
    background: linear-gradient(
      160deg,
      rgba(42, 53, 102, 0.50) 0%,
      rgba(58, 74, 134, 0.44) 40%,
      rgba(95, 111, 184, 0.38) 72%,
      rgba(159, 182, 230, 0.34) 100%
    );
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
  }
  /* 本文すりガラスパネル（AA確保） */
  .hero__copy {
    background: rgba(26, 34, 72, 0.62);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3.5vw, 2.2rem);
    box-shadow: 0 18px 44px -18px rgba(10, 15, 45, 0.55);
  }
  .hero__eyebrow {
    font-family: var(--font-display);
    letter-spacing: 0.14em;
    opacity: 0.92;
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.6vw, 3.1rem);
    text-shadow: 0 2px 18px rgba(20, 30, 70, 0.45);
  }
  .hero__lead {
    margin: 1.2rem 0 1.8rem;
    max-width: 46ch;
    font-size: 1.02rem;
    color: rgba(255, 255, 255, 0.95);
  }
  .hero__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  /* 積荷マニフェスト: 水彩の世界に、船の積荷リストが少しだけデジタルに混ざる感じ */
  .hero__manifest-q {
    margin: 1.4rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }
  .hero__manifest {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 0.7rem;
  }
  .hero__manifest a {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    padding: 0.32rem 0.7rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .hero__manifest a:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .hero__manifest b {
    font-family: var(--font-display);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    font-weight: 400;
  }
  .hero__manifest span { font-size: 0.66rem; color: rgba(255, 255, 255, 0.78); white-space: nowrap; }
  .hero__art { justify-self: center; position: relative; }
  /* 動く AYN: 円窓。読み込めたら画像の上に重ねて、画像は隠す */
  .hero__rig {
    display: none;
    position: relative;
    width: min(72vw, 420px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 20px 60px -18px rgba(10, 15, 45, 0.6);
    border: 4px solid rgba(255, 255, 255, 0.3);
    background:
      radial-gradient(70% 70% at 50% 35%, rgba(214, 226, 255, 0.9), rgba(150, 170, 230, 0.8) 60%, rgba(74, 92, 160, 0.9));
  }
  .hero__rig.is-on { display: block; }
  .hero__rig.is-on + .hero__img { display: none; }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__bubble {
    position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%) translateY(6px);
    max-width: 86%; padding: 0.45rem 0.9rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.92); color: #2a3566; font-size: 0.9rem; font-weight: 700;
    white-space: nowrap; opacity: 0; transition: opacity .25s, transform .25s; pointer-events: none;
  }
  .hero__bubble.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }
  @media (prefers-reduced-motion: reduce) { .hero__rig { display: none !important; } .hero__rig + .hero__img { display: block !important; } }
  .hero__img {
    width: min(72vw, 420px);
    height: auto;
    border-radius: 50%;
    box-shadow: 0 20px 60px -18px rgba(10, 15, 45, 0.6);
    border: 4px solid rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 720px) {
    .hero__inner { grid-template-columns: 1fr; text-align: center; }
    .hero__manifest { justify-content: center; }
    .hero__manifest a { align-items: center; }
    .hero__lead { margin-inline: auto; }
    .hero__cta { justify-content: center; }
    .hero__art { order: -1; }
    /* スマホは縦に長くなるけん、「何を作っとる場所か」を見出しの直下に上げる。
       初見の人が1画面で分かるようにする（順番だけ入れ替え・文言は同じ）。 */
    .hero__copy { display: flex; flex-direction: column; }
    .hero__eyebrow { order: 1; }
    .hero__title { order: 2; }
    .hero__manifest-q { order: 3; margin-top: 1rem; }
    .hero__manifest { order: 4; }
    .hero__lead { order: 5; margin-top: 1.2rem; margin-bottom: 1.4rem; }
    .hero__cta { order: 6; }
    /* AYN の円窓をほんの少し小さく＝1画面に収まる余地をつくる */
    .hero__rig, .hero__img { width: min(62vw, 420px); }
  }
</style>

<script>
  // 動く AYN（ayn-jarvis のリグ）。失敗したら静止画のまま。
  (async () => {
    const host = document.getElementById('ayn-rig');
    if (!host || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      await new Promise((res, rej) => { const s = document.createElement('script'); s.src = host.dataset.js; s.onload = res; s.onerror = rej; document.head.appendChild(s); });
      const canvas = host.querySelector('canvas');
      const rig = new window.AynRig(canvas, host.dataset.rig, { zoom: 1.0 });
      await rig.load();
      // 夜(22〜6時・閲覧者のローカル時刻)はパジャマ(rig.json outfits・Prompt216-5)。無い rig.json なら default のまま
      const autoOutfit = () => { if (!rig.setOutfit) return; const h = new Date().getHours(); rig.setOutfit(h >= 22 || h < 6 ? 'pajama' : 'default'); };
      autoOutfit(); setInterval(autoOutfit, 60000);
      host.classList.add('is-on');
      let speaking = false, env = null, envStart = 0, envDur = 0, level = 0, levelS = 0;
      let nextBlink = performance.now() + 1800, blinkUntil = 0, last = performance.now();
      const bubble = host.querySelector('.hero__bubble');
      const lines = [['ようこそ、ボクのフネへ。', 'happy'], ['ゆっくり見ていってほしか。', 'kubikashige'], ['アプリも音楽も、ぜんぶここばい。', 'wink'], ['眠れん夜は、Sleep Radio やけんね。', 'surprise']];
      let li = 0;
      const talk = () => {
        const [text, expr] = lines[li++ % lines.length];
        const dur = 1.2 + text.length * 0.11;
        rig.setExpression(expr); setTimeout(() => rig.setExpression('neutral'), dur * 1000 + 800);
        env = Array.from({ length: Math.round(dur * 25) }, (_, i) => 0.35 + 0.65 * Math.abs(Math.sin(i * 0.8 + Math.sin(i * 0.3))));
        envStart = performance.now(); envDur = dur * 1000; speaking = true;
        bubble.textContent = text; bubble.classList.add('is-on');
        setTimeout(() => bubble.classList.remove('is-on'), dur * 1000 + 600);
      };
      host.addEventListener('click', talk);
      setTimeout(talk, 1500);
      const frame = (now) => {
        if (env) { const i = Math.floor((now - envStart) / envDur * env.length); if (i < env.length) level = env[i]; else { env = null; speaking = false; level = 0; } }
        levelS += (level - levelS) * 0.35;
        if (now > nextBlink) { blinkUntil = now + 120; nextBlink = now + 2600 + Math.random() * 3400; }
        rig.render((now - last) / 1000, { level: levelS, speaking, blink: now < blinkUntil, t: now / 1000 });
        last = now; requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    } catch (e) { console.warn('AYN rig fallback:', e); }
  })();
</script>
