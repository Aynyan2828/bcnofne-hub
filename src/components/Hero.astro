---
import { Image } from 'astro:assets';
import keyVisual from '../assets/ayn-keyvisual.png';
---
<header class="hero" id="top">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">BCNOFNe〜ボクのフネ〜</p>
      <h1 class="hero__title">
        情報の海を、<br />ぼくと一緒に航海しようや。
      </h1>
      <p class="hero__lead">
        機関士AI の <strong>AYN（あゆにゃん）</strong> ばい。
        アプリも、眠れん夜の音楽も、ラジオも、ぜんぶこの一枚にまとめとうけん。
        気になるところから、ゆっくり見ていってほしか。
      </p>
      <div class="hero__cta">
        <a class="btn" href="#apps">アプリを見る</a>
        <a class="btn btn--ghost" href="#about">AYN ってなに？</a>
      </div>
    </div>
    <div class="hero__art">
      <Image
        src={keyVisual}
        alt="水彩で描かれた機関士AI AYN。青紫の髪に赤メガネ、夜空と流星の航海シーン。"
        widths={[320, 480, 640]}
        sizes="(max-width: 720px) 70vw, 420px"
        loading="eager"
        class="hero__img"
      />
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    background: var(--grad-hero);
    color: #fff;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 6rem);
  }
  .hero__glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    background: radial-gradient(60% 80% at 30% 20%, rgba(244,166,196,0.35), transparent 60%),
      radial-gradient(50% 70% at 80% 10%, rgba(139,123,216,0.4), transparent 60%);
    filter: blur(10px);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
  }
  .hero__eyebrow {
    font-family: var(--font-display);
    letter-spacing: 0.14em;
    opacity: 0.9;
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.6vw, 3.1rem);
    text-shadow: 0 2px 18px rgba(20, 30, 70, 0.35);
  }
  .hero__lead {
    margin: 1.2rem 0 1.8rem;
    max-width: 46ch;
    font-size: 1.02rem;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .hero__art { justify-self: center; }
  .hero__img {
    width: min(72vw, 420px);
    height: auto;
    border-radius: 50%;
    box-shadow: 0 20px 60px -18px rgba(10, 15, 45, 0.6);
    border: 4px solid rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 720px) {
    .hero__inner { grid-template-columns: 1fr; text-align: center; }
    .hero__lead { margin-inline: auto; }
    .hero__cta { justify-content: center; }
    .hero__art { order: -1; }
  }
</style>
