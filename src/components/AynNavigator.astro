---
/**
 * AYN ナビゲーション（操舵室のインターホン）
 *
 * 右下の小さな丸い AYN。押すと「今日はどこ行くと？」と行き先を出す。
 * いまは**サイト内ナビだけ**（LLM チャットではない）。将来ほんとのチャットを
 * 繋ぐときは、パネルの中身を差し替えるだけで済むように
 *   window.AYN_NAV = { open, close, say(text), setStatus(text) }
 * を公開しとる（下の script 末尾）。say() に文字を渡すと吹き出しが差し替わる。
 *
 * スマホ: 44px の丸だけ（文字なし）。safe-area を見て親指の邪魔にならん位置へ。
 * prefers-reduced-motion: ふわっと出る動きをやめて即表示（global.css が transition を止める）。
 */
import { Image } from 'astro:assets';
import aynOk from '../assets/ayn/ayn-ok.png';
import { STATIONS } from '../lib/voyage';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * AYN に直接聞ける窓口（本物の会話）。
 *
 * ── 2026-09-22: マスター判断で【見送り】。空のまま置いとく。 ──
 * 理由: 公開サイトから家の Jarvis へ口を開けると
 *   (1) プロンプトインジェクション（誰でもぼくに何でも言わせられる）
 *   (2) 誰でも無限に叩けて、LLM のコストが全部こっち持ち
 * になる。見返りに対してリスクが大きすぎる、という結論。
 * 気が変わった時だけ、下の空文字を bcnofne-edge のオリジンに変える:
 *   'https://bcnofne-edge.aynbcnofne.workers.dev' → POST {origin}/ask {q} → {answer}
 * その時も **Jarvis を直で公開せん**こと。必ず Worker を挟んで
 * レート制限・1日の上限・Funnel URL の秘匿をやる（乱用とコストの盾）。
 * 空文字のあいだは入力欄ごと DOM に出さんけん、攻撃面はゼロばい。
 */
const ASK_ENDPOINT = '';

// 行き先＝航路の寄港地（PORT を除く）＋ 港の外の用事
const routes = [
  ...STATIONS.filter((s) => s.id !== 'top').map((s) => ({
    href: `#${s.id}`,
    label: s.label,
    note: s.note,
    external: false,
  })),
  { href: `${base}/angleon/`, label: '新作 Angleon を見る', note: '制作中・事前登録', external: false },
  { href: `${base}/shortcuts`, label: 'ショートカットをもらう', note: 'AYNにまかせんしゃい', external: false },
  { href: '#contact', label: 'おたよりを出す', note: 'ぼくに直接届くばい', external: false },
];
---
<div class="aynnav" data-aynnav>
  <button
    class="aynnav__btn"
    type="button"
    data-aynnav-toggle
    aria-expanded="false"
    aria-controls="aynnav-panel"
  >
    <span class="aynnav__face">
      <Image src={aynOk} alt="" width={96} height={96} loading="lazy" />
      <span class="aynnav__pulse" aria-hidden="true"></span>
    </span>
    <span class="aynnav__id" aria-hidden="true">
      <b>AYN</b>
      <span class="aynnav__status" data-aynnav-status>● ONLINE</span>
    </span>
    <span class="visually-hidden">AYN に行き先を聞く</span>
  </button>

  {/* 初回だけ出る小さな吹き出し。ここに AYN が居って案内役やと分かってもらう。
      2回目以降は出さん（localStorage に1回だけ印を付ける）。 */}
  <p class="aynnav__hint" data-aynnav-hint hidden aria-hidden="true">
    どこ行くか、聞いてもよかよ
  </p>

  <div class="aynnav__panel" id="aynnav-panel" data-aynnav-panel role="dialog" aria-label="AYN の行き先案内" hidden>
    <div class="aynnav__head">
      <span class="aynnav__headname">AYN</span>
      <span class="aynnav__headstatus" data-aynnav-status2>● ONLINE</span>
      <button class="aynnav__close" type="button" data-aynnav-close aria-label="閉じる">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <p class="aynnav__say" data-aynnav-say aria-live="polite">今日はどこ行くと？</p>
    <ul class="aynnav__routes">
      {routes.map((r) => (
        <li>
          <a href={r.href} data-aynnav-go>
            <span class="aynnav__label">{r.label}</span>
            <span class="aynnav__note">{r.note}</span>
          </a>
        </li>
      ))}
    </ul>

    {ASK_ENDPOINT && (
      <form class="aynnav__ask" data-aynnav-ask data-endpoint={ASK_ENDPOINT}>
        <label class="visually-hidden" for="aynnav-q">AYN に聞く</label>
        <input id="aynnav-q" type="text" name="q" maxlength="200" placeholder="ぼくに聞いてもよかよ" autocomplete="off" />
        <button type="submit" aria-label="送る">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    )}

    {/* 航海日誌: 寄った港にスタンプが灯る。全部回ると AYN がひとこと言う */}
    <div class="aynnav__log" data-aynnav-log hidden>
      <span class="aynnav__stamps" aria-hidden="true">
        {STATIONS.map((s) => (
          <i data-stamp={s.id} title={s.code}></i>
        ))}
      </span>
      <span class="aynnav__logcount" data-aynnav-logcount></span>
    </div>

    <p class="aynnav__foot">
      {ASK_ENDPOINT
        ? '答えはぼくの機関室から返しよる。うまく届かん時もあるけん、そこは許してほしか。'
        : 'いまは行き先案内だけ。じきに、ここでぼくと直に話せるようにするばい。'}
    </p>
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-aynnav]');
    if (!root) return;
    const btn = root.querySelector('[data-aynnav-toggle]');
    const panel = root.querySelector('[data-aynnav-panel]');
    const sayEl = root.querySelector('[data-aynnav-say]');
    const closeBtn = root.querySelector('[data-aynnav-close]');
    const statusEls = root.querySelectorAll('[data-aynnav-status], [data-aynnav-status2]');

    // 時刻で第一声を変える（閲覧者のローカル時刻）
    const greet = () => {
      const h = new Date().getHours();
      if (h >= 22 || h < 5) return 'まだ起きとると？ どこ行くと？';
      if (h < 11) return 'おはよう。今日はどこ行くと？';
      if (h < 17) return 'こんにちは。どこ行くと？';
      return 'お疲れさん。今日はどこ行くと？';
    };
    sayEl.textContent = greet();

    // 航海日誌の状態（setOpen から参照するけん先に宣言）
    let pendingComplete = false;
    let saidComplete = false;
    const DONE_LINE = 'ぜんぶの港を回ったね。ありがとう、よか航海やった。';

    let open = false;
    const setOpen = (v) => {
      open = v;
      panel.hidden = !v;
      root.classList.toggle('is-open', v);
      btn.setAttribute('aria-expanded', String(v));
      if (v) {
        // 待たせとった労い（全港クリア）があればそっちを優先
        if (pendingComplete && !saidComplete) {
          pendingComplete = false;
          saidComplete = true;
          sayEl.textContent = DONE_LINE;
        } else {
          sayEl.textContent = greet();
        }
        const first = panel.querySelector('[data-aynnav-go]');
        if (first) first.focus({ preventScroll: true });
      }
    };

    /* ── 初回だけの吹き出し ──────────────────────────────────
       右下の丸が「ただの絵」に見えんように、初めての人にだけ一声かける。
       一度出したら localStorage に印を付けて、二度と出さん。
       押された／パネルを開いた時点でも引っ込める（邪魔せん）。 */
    const hintEl = root.querySelector('[data-aynnav-hint]');
    const HINT_KEY = 'bcnofne_aynnav_greeted';
    let hintTimer = 0;
    const hideHint = () => {
      if (!hintEl || hintEl.hidden) return;
      hintEl.classList.remove('is-on');
      clearTimeout(hintTimer);
      hintTimer = setTimeout(() => { hintEl.hidden = true; }, 500);
    };
    const maybeGreet = () => {
      if (!hintEl) return;
      try {
        if (localStorage.getItem(HINT_KEY)) return; // もう会うたことがある
        localStorage.setItem(HINT_KEY, '1');
      } catch (_) {
        // 憶えられん環境（プライベートモード等）では、毎回出すと鬱陶しいけん出さん
        return;
      }
      hintEl.hidden = false;
      // 表示を挟んでからクラスを付けて、ふわっと出す。
      // rAF は描画が止まっとる環境（裏タブ・描画エンジン）で呼ばれんけん使わん。
      // ここで点かんと吹き出しが opacity:0 のまま居座るだけになる。
      setTimeout(() => hintEl.classList.add('is-on'), 30);
      hintTimer = setTimeout(hideHint, 6500);
    };
    // 読み込み直後やと目が向いとらんけん、少し落ち着いてから
    setTimeout(maybeGreet, 2600);

    btn.addEventListener('click', () => { hideHint(); setOpen(!open); });
    closeBtn.addEventListener('click', () => { setOpen(false); btn.focus({ preventScroll: true }); });
    // 行き先を選んだら閉じる（スクロールの邪魔をせん）
    for (const a of panel.querySelectorAll('[data-aynnav-go]')) {
      a.addEventListener('click', () => setOpen(false));
    }
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) { setOpen(false); btn.focus({ preventScroll: true }); }
    });
    // だいぶスクロールされたら、見てもらえんかったということで静かに引っ込める
    addEventListener('scroll', () => { if (scrollY > innerHeight * 1.6) hideHint(); }, { passive: true });
    addEventListener('click', (e) => {
      if (open && !root.contains(e.target)) setOpen(false);
    });

    // 将来の AI チャット差し替え用の口（ここに繋げばそのまま喋らせられる）
    const api = {
      open: () => setOpen(true),
      close: () => setOpen(false),
      say: (text) => { sayEl.textContent = String(text); },
      setStatus: (text) => { for (const el of statusEls) el.textContent = String(text); },
    };
    window.AYN_NAV = api;

    /* ── 航海日誌スタンプ ────────────────────────────────────────
       VoyageRail が 'bcnofne:voyage' を投げてくる。寄った港が灯る。
       全部回ったら一度だけ労う（閉じとる時に達成したら、次に開いた時に言う）。 */
    const logEl = root.querySelector('[data-aynnav-log]');
    const countEl = root.querySelector('[data-aynnav-logcount]');

    document.addEventListener('bcnofne:voyage', (e) => {
      const d = e.detail || {};
      const visited = d.visited || [];
      for (const i of logEl.querySelectorAll('[data-stamp]')) {
        i.classList.toggle('is-on', visited.includes(i.getAttribute('data-stamp')));
      }
      countEl.textContent = `${visited.length} / ${d.total} の港`;
      logEl.hidden = visited.length === 0;
      if (d.complete) {
        root.classList.add('is-complete');
        if (!saidComplete) {
          if (open) { saidComplete = true; api.say(DONE_LINE); }
          else pendingComplete = true;
        }
      }
    });

    /* ── AYN に直接聞く（ASK_ENDPOINT がある時だけ DOM に居る）──── */
    const askForm = root.querySelector('[data-aynnav-ask]');
    if (askForm) {
      const input = askForm.querySelector('input[name="q"]');
      askForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const q = (input.value || '').trim();
        if (q.length < 2) return;
        const ep = askForm.getAttribute('data-endpoint');
        api.setStatus('● THINKING');
        api.say('ちょっと待っとって…');
        input.value = '';
        try {
          const res = await fetch(ep + '/ask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ q }),
          });
          const data = await res.json().catch(() => ({}));
          api.say(res.ok && data.answer ? data.answer : 'うまく届かんかった。もう一回頼む。');
        } catch (_) {
          api.say('通信がうまくいかんかった。あとでまた聞いてほしか。');
        } finally {
          api.setStatus('● ONLINE');
        }
      });
    }
  })();
</script>

<style>
  .aynnav {
    position: fixed;
    right: max(0.8rem, env(safe-area-inset-right));
    bottom: max(0.8rem, env(safe-area-inset-bottom));
    z-index: 40;
    font-size: 0.9rem;
  }

  /* ── 呼び出しボタン ─────────────────────────────────────────── */
  .aynnav__btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0.3rem;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 10px 26px -12px rgba(31, 37, 64, 0.5);
    cursor: pointer;
    font-family: inherit;
    color: var(--c-ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .aynnav__btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -12px rgba(31, 37, 64, 0.55); }
  .aynnav__face {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--c-mist);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9);
  }
  .aynnav__face :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .aynnav__pulse {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #57c4a3;
    border: 2px solid #fff;
    animation: aynPulse 3.2s ease-in-out infinite;
  }
  @keyframes aynPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(87, 196, 163, 0.5); }
    50% { box-shadow: 0 0 0 5px rgba(87, 196, 163, 0); }
  }
  .aynnav__id {
    display: none;
    line-height: 1.25;
    padding-right: 0.55rem;
    text-align: left;
  }
  .aynnav__id b { font-family: var(--font-display); font-size: 0.78rem; letter-spacing: 0.1em; font-weight: 400; display: block; }
  .aynnav__status { font-size: 0.75rem; letter-spacing: 0.1em; color: #3f9c82; }
  /* 文字は広い画面だけ（スマホは丸だけ＝邪魔せん） */
  @media (min-width: 560px) { .aynnav__id { display: block; } }

  /* ── 初回だけの吹き出し ──────────────────────────────────────── */
  .aynnav__hint {
    position: absolute;
    right: 46px;
    bottom: 6px;
    margin: 0;
    max-width: min(52vw, 210px);
    padding: 0.42rem 0.8rem;
    border-radius: 14px 14px 4px 14px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--c-line);
    box-shadow: 0 10px 24px -14px rgba(31, 37, 64, 0.6);
    color: var(--c-ink);
    font-size: 0.78rem;
    line-height: 1.5;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(8px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
  }
  .aynnav__hint.is-on { opacity: 1; transform: none; }
  .aynnav__hint[hidden] { display: none; }
  /* 吹き出しの尻尾（AYN の方を向く小さな三角） */
  .aynnav__hint::after {
    content: '';
    position: absolute;
    right: -5px;
    bottom: 8px;
    width: 9px;
    height: 9px;
    background: inherit;
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    transform: rotate(-45deg);
    border-radius: 0 0 3px 0;
  }
  /* 文字が大きい端末で折り返しても崩れんように */
  @media (max-width: 360px) {
    .aynnav__hint { white-space: normal; }
  }

  /* ── パネル ─────────────────────────────────────────────────── */
  .aynnav__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.55rem);
    width: min(76vw, 288px);
    max-height: min(62vh, 460px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--c-line);
    border-radius: 16px;
    box-shadow: 0 20px 48px -18px rgba(31, 37, 64, 0.55);
    padding: 0.7rem 0.8rem 0.6rem;
    transform-origin: 100% 100%;
    animation: aynNavIn 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @keyframes aynNavIn {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  .aynnav__head {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed var(--c-line);
  }
  .aynnav__headname { font-family: var(--font-display); font-size: 0.82rem; letter-spacing: 0.12em; }
  .aynnav__headstatus { font-size: 0.75rem; letter-spacing: 0.1em; color: #3f9c82; }
  .aynnav__close {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--c-ink-soft);
    cursor: pointer;
    padding: 0.2rem;
    line-height: 0;
    border-radius: 6px;
  }
  .aynnav__close:hover { color: var(--c-ink); }
  .aynnav__say {
    margin: 0.55rem 0 0.6rem;
    font-size: 0.9rem;
    color: var(--c-ink);
  }
  .aynnav__routes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .aynnav__routes a {
    display: block;
    padding: 0.42rem 0.55rem;
    border-radius: 10px;
    color: var(--c-ink);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .aynnav__routes a:hover { background: var(--c-mist); text-decoration: none; }
  .aynnav__label { display: block; font-size: 0.88rem; }
  .aynnav__note { display: block; font-size: 0.75rem; color: var(--c-ink-soft); }
  /* 航海日誌スタンプ */
  .aynnav__log {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--c-line);
  }
  .aynnav__log[hidden] { display: none; }
  .aynnav__stamps { display: flex; gap: 0.28rem; }
  .aynnav__stamps i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--c-line);
    background: transparent;
    transition: background 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
  }
  .aynnav__stamps i.is-on {
    background: var(--grad-accent);
    border-color: transparent;
    box-shadow: 0 0 6px -1px rgba(139, 123, 216, 0.8);
  }
  .aynnav__logcount { font-size: 0.75rem; color: var(--c-ink-soft); letter-spacing: 0.06em; }
  /* 全部回った人の AYN には、小さな灯りが残る */
  .aynnav.is-complete .aynnav__face { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.9), 0 0 0 2px rgba(244, 166, 196, 0.55); }

  /* AYN に直接聞く欄（ASK_ENDPOINT を入れた時だけ出る） */
  .aynnav__ask {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.6rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--c-line);
  }
  .aynnav__ask input {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 0.84rem;
    color: var(--c-ink);
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--c-line);
    border-radius: 10px;
    background: var(--c-cream);
  }
  .aynnav__ask input:focus { outline: none; border-color: var(--c-blue); box-shadow: 0 0 0 3px rgba(106, 169, 224, 0.2); }
  .aynnav__ask button {
    border: 0;
    border-radius: 10px;
    padding: 0 0.6rem;
    background: var(--grad-ink);
    color: #fff;
    cursor: pointer;
    line-height: 0;
  }

  .aynnav__foot {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--c-ink-soft);
    border-top: 1px dashed var(--c-line);
    padding-top: 0.45rem;
  }
</style>
