---
import { buildGraph, buildLiteGraph } from '../lib/structured-data';
// SEO: title/description/OGP/Twitter Card/JSON-LD をまとめて出力
interface Props {
  title: string;
  description: string;
  ogImage?: string; // base込みの絶対 or ルート相対パス
  lang?: 'ja' | 'en';
  /** hreflang（言語違いの対ページ）。path は base 抜きのルート相対 */
  alternates?: { lang: string; path: string }[];
  /** ページだけの構造化データ（@graph に足す） */
  extraJsonLd?: Record<string, unknown>[];
}
const { title, description, ogImage = 'og/og-default.jpg', lang = 'ja', alternates = [], extraJsonLd = [] } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const altUrl = (path: string) => new URL(basePath + path, Astro.site).href;

// 絶対URL化（OGP は絶対URL必須）
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(
  import.meta.env.BASE_URL.replace(/\/$/, '') + '/' + ogImage.replace(/^\//, ''),
  Astro.site,
).href;

// 構造化データ（JSON-LD）。トップ（日英）は全部入り、他のページは運営者＋ページだけ。
// 中身は src/lib/structured-data.ts（content の md から組み立てる）
const site = Astro.site ?? new URL('https://bcnofne.com');
const pageInfo = { url: canonical, title, description, lang, image: ogImageUrl };
const pathNoBase = Astro.url.pathname.slice(basePath.length).replace(/\/?$/, '/');
const isHome = pathNoBase === '/' || pathNoBase === '/en/';
const graph = isHome ? await buildGraph(site, pageInfo) : buildLiteGraph(site, pageInfo);
const jsonLd = { ...graph, '@graph': [...graph['@graph'], ...extraJsonLd] };
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={altUrl(a.path)} />)}

<!-- OGP -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="BCNOFNe" />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
{alternates.filter((a) => a.lang !== lang && a.lang !== 'x-default').map((a) => (
  <meta property="og:locale:alternate" content={a.lang === 'en' ? 'en_US' : 'ja_JP'} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
