---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import HarborGate from './HarborGate.astro';
import TypeText from './TypeText.astro';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  mist?: boolean;
  avatar?: ImageMetadata; // 見出しに添える丸いAYN
  avatarAlt?: string;
  /** 港の名前（例: APPS HARBOR）。指定すると手前に「港の入口」の一画面が入る。 */
  harbor?: string;
  /** 港の入口に出す日本語の一行（例: アプリの港） */
  harborLabel?: string;
  /** 港で迎える AYN の絵の名前（public/world/<harborAyn>.webp） */
  harborAyn?: string;
  /** 港の色。見出しを走る帯と、そのあと残る文字の色が変わる */
  tone?: 'blue' | 'purple' | 'rose' | 'teal' | 'amber';
}
const { id, eyebrow, title, lead, mist = false, avatar, avatarAlt,
        harbor, harborLabel, harborAyn, tone = 'blue' } = Astro.props;

/* 一行説明は「文ごと」に分けて、2文目・4文目…にその港の色を乗せる。
   見せてもろうた参考サイトは行ごとに色が変わっとったけど、CSS で
   **表示上の行**は掴めん（折り返しは画面幅で変わる）。文で切るのが正しい。 */
const leadParts = lead ? lead.split(/(?<=。)/).filter(Boolean) : [];
---
{/* 港の入口。海と空だけの一画面を挟んで「着いた」を作る。
    紙だまりの外に置くけん、ここだけ背景（海・空・月）が素で見える。 */}
{harbor && <HarborGate harbor={harbor} label={harborLabel} ayn={harborAyn} tone={tone} port={id} />}

<section id={id} data-tone={tone} class:list={['section', { 'section--mist': mist }]}>
  <div class="container">
    <div class="section-head" data-reveal="up">
      {avatar && (
        <div class="section-avatar">
          <Image src={avatar} alt={avatarAlt ?? `${title}のAYN`} width={112} height={112} loading="lazy" />
        </div>
      )}
      {eyebrow && <TypeText as="span" class="eyebrow" text={eyebrow} />}
      <TypeText as="h2" text={title} />
      {leadParts.length > 0 && (
        <p>{leadParts.map((part, i) => (
          <span class={i % 2 === 1 ? 's-odd' : undefined}>{part}</span>
        ))}</p>
      )}
    </div>
    <slot />
  </div>
</section>

<style>
  .section-avatar {
    width: clamp(76px, 14vw, 104px);
    aspect-ratio: 1;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-soft);
    background: var(--c-mist);
  }
  .section-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

</style>
