---
/**
 * SweepText — 色の帯が文字の上を一度だけ走って、通り過ぎたあとに文字が残る。
 *
 * whatever.co のあれ。「最初カラフルな面が流れてきて、そのあと文字が固定される」。
 * 前に入れた LightWash（海の照り返しが常にゆっくり流れる帯）とは別もので、
 * こっちは **到着した時に一回だけ走る**。マスターが見せてくれた動画はこっち。
 *
 * 動き:
 *   1. 文字は伏せたまま、左から色の帯が伸びる（0 → 46%）
 *   2. 帯が右へ抜ける（47% → 100%）。抜けた端から文字が出てくる
 *   3. 文字はその港の色（--sw-ink）で固定される＝墨一色に戻らん
 *
 * 色は港ごと。`.section` に data-tone を付けると帯も文字色も一緒に変わる。
 *
 * ★progressive enhancement は Reveal と同じ約束。
 *   `html.reveal-on` が付いた時だけ文字を伏せる。JS が落ちても文字は読める
 *   （帯は scaleX(0) のまま＝見えん）。検索エンジンに隠しテキスト扱いされん。
 */
interface Props {
  /** 外側のタグ。見出しなら h2 を渡す。既定は span */
  as?: string;
  class?: string;
}
const { as: Tag = 'span', class: cls } = Astro.props;
---
<Tag class:list={[cls]}>
  <span class="sweep" data-sweep>
    <span class="sweep__ink"><slot /></span>
  </span>
</Tag>

<style is:global>
  .sweep {
    position: relative;
    display: inline-block;
    /* 通り過ぎたあと、文字はこの色で残る（港ごとに変わる） */
    color: var(--sw-ink, var(--c-ink));
  }

  /* 走る帯。文字より上に出したいけん ::after（＝最後の子）で作る */
  .sweep::after {
    content: '';
    position: absolute;
    inset: -0.14em -0.32em;
    border-radius: 3px;
    background: linear-gradient(100deg, var(--sw-a, #6aa9e0), var(--sw-b, #8b7bd8));
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  html.reveal-on .sweep .sweep__ink { opacity: 0; }
  html.reveal-on .sweep.is-in .sweep__ink { animation: sweep-ink 0.95s linear forwards; }
  html.reveal-on .sweep.is-in::after {
    animation: sweep-bar 0.95s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  @keyframes sweep-bar {
    0%   { transform: scaleX(0); transform-origin: left center; }
    /* 46→47% は scaleX(1) のまま基点だけ入れ替える。伸び切っとるけん段差は出ん */
    46%  { transform: scaleX(1); transform-origin: left center; }
    47%  { transform: scaleX(1); transform-origin: right center; }
    100% { transform: scaleX(0); transform-origin: right center; }
  }
  /* 帯が抜けはじめた瞬間に文字が出る。帯の下から現れる見え方になる */
  @keyframes sweep-ink {
    0%, 46%   { opacity: 0; }
    47%, 100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    html.reveal-on .sweep .sweep__ink { opacity: 1; }
    .sweep::after { display: none; }
  }
</style>
