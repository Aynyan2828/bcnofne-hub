---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import CollageBackdrop from '../components/CollageBackdrop.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'BCNOFNe〜ボクのフネ〜｜機関士AI AYN の公式ハブ',
  description = '機関士AI AYN と一緒に、Crypto Ocean を航海するBCNOFNe の公式ハブ。iOSアプリ・睡眠BGM・AI RADIO・音楽配信・SNS をここに集めたばい。',
  ogImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- JS ありを最初に宣言: 到着演出などを「JSがある時だけ伏せる」ため（ちらつき防止）。
         ついでに潮（tide）も head で決める＝夜に来た人は最初から夜の海で迎える。
         22〜6時＝night。Hero の AYN がパジャマに着替える時刻と同じ窓ばい。 -->
    <script is:inline>
      document.documentElement.classList.add('has-js');
      (function () {
        var h = new Date().getHours();
        document.documentElement.dataset.tide = h >= 22 || h < 6 ? 'night' : 'day';
      })();
    </script>
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <!-- 手書き風フォント：本文=Yomogi(ゆる丸手書き) / 見出し=Yusei Magic(マーカー風) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yomogi&family=Yusei+Magic&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} {...(ogImage ? { ogImage } : {})} />
  </head>
  <body>
    <CollageBackdrop />
    <a href="#main" class="skip-link">本文へスキップ</a>
    <slot />
    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: #fff;
        color: var(--c-ink);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        z-index: 100;
        transition: top 0.2s ease;
      }
      .skip-link:focus { top: 1rem; }
    </style>
  </body>
</html>
