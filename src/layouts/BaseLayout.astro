---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import CollageBackdrop from '../components/CollageBackdrop.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'BCNOFNe〜ボクのフネ〜｜機関士AI AYN の公式ハブ',
  description = '機関士AI AYN と一緒に、Crypto Ocean を航海するBCNOFNe の公式ハブ。iOSアプリ・睡眠BGM・AI RADIO・音楽配信・SNS をここに集めたばい。',
  ogImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!--
      出現演出の「伏せてよいか」判定（progressive enhancement）。

      本文は既定で**見えとる**。ここで `reveal-on` が付いた時だけ CSS が伏せて、
      IntersectionObserver が灯す。つまり演出を動かせる確証がある時だけ隠す。
      付けんのは次のどれかに当たる時:
        - IntersectionObserver が無い
        - 動きを減らす設定（prefers-reduced-motion）
        - 読み込み時点で画面が見えとらん（裏タブ・描画エンジン・プレビュー枠）
          ※ 非表示やと IO のコールバックが一度も来んことがある。実際に踏んだ。
      判定を head の同期スクリプトでやるけん、一瞬出てから隠れる「ちらつき」も無い。
      JS が落ちても・バンドルが届かんでも、本文はそのまま読める＝クローラー安全。

      ついでに潮（tide）も head で決める＝夜に来た人は最初から夜の海で迎える。
      22〜6時＝night。Hero の AYN がパジャマに着替える時刻と同じ窓ばい。
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('has-js');

        var canReveal =
          'IntersectionObserver' in window &&
          !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) &&
          document.visibilityState === 'visible';
        if (canReveal) d.classList.add('reveal-on');

        var h = new Date().getHours();
        d.dataset.tide = h >= 22 || h < 6 ? 'night' : 'day';
      })();
    </script>
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <!-- 手書き風フォント：本文=Yomogi(ゆる丸手書き) / 見出し=Yusei Magic(マーカー風) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yomogi&family=Yusei+Magic&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} {...(ogImage ? { ogImage } : {})} />
  </head>
  <body>
    <CollageBackdrop />
    <a href="#main" class="skip-link">本文へスキップ</a>
    <slot />
    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: #fff;
        color: var(--c-ink);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        z-index: 100;
        transition: top 0.2s ease;
      }
      .skip-link:focus { top: 1rem; }
    </style>
  </body>
</html>
